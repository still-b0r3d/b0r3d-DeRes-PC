<UserControl x:Class="B0r3dDeRes.ExifStage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource Text}">
    <!-- The EXIF tools' inspector (the website's ui/scrub-stage.ts): a batch's rows, the picture,
         the Verified Clean banner, the line about the file, the AI, Content Credentials, GPS,
         thumbnail and trailing-bytes boxes, and the Metadata Inspector's Summary and All Tags. -->
    <UserControl.Resources>
        <Style x:Key="Alert" TargetType="Border">
            <Setter Property="BorderThickness" Value="4,0,0,0" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,12,0,0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="{DynamicResource Panel}" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
        <Style x:Key="AlertTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="AlertBody" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <!-- a batch's row: name, format, size, GPS, trailer, status -->
        <DataTemplate x:Key="BatchRow">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="88" />
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="74" />
                    <ColumnDefinition Width="110" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                <TextBlock Grid.Column="1" Text="{Binding Format}" />
                <TextBlock Grid.Column="2" Text="{Binding Size}" TextAlignment="Right" Margin="0,0,12,0" />
                <TextBlock x:Name="GpsCell" Grid.Column="3" Text="{Binding Gps}" Opacity="0.7" />
                <TextBlock x:Name="TrailerCell" Grid.Column="4" Text="{Binding Trailer}" Opacity="0.7" />
                <TextBlock x:Name="StatusCell" Grid.Column="5" Text="{Binding Status}" ToolTip="{Binding StatusTip}" FontWeight="SemiBold" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding GpsAlert}" Value="True">
                    <Setter TargetName="GpsCell" Property="Opacity" Value="1" />
                    <Setter TargetName="GpsCell" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding TrailerAlert}" Value="True">
                    <Setter TargetName="TrailerCell" Property="Opacity" Value="1" />
                    <Setter TargetName="TrailerCell" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Pending}" Value="True">
                    <Setter TargetName="StatusCell" Property="Opacity" Value="0.7" />
                    <Setter TargetName="StatusCell" Property="FontWeight" Value="Normal" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <!-- the batch's rows: a plain list, the row picked marked in the accent colour -->
        <Style x:Key="Rows" TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource Field}" />
            <Setter Property="BorderBrush" Value="{DynamicResource FieldLine}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ScrollViewer Focusable="False" CanContentScroll="True">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Foreground" Value="{DynamicResource Text}" />
                        <Setter Property="Padding" Value="8,4" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Row" Background="Transparent" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource ButtonHover}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource Accent}" />
                                            <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <TextBlock x:Name="Message" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="440" Margin="20"
                   Foreground="{DynamicResource Dim}" Text="Choose a photo to inspect and scrub its metadata." />
        <ScrollViewer x:Name="Body" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Visibility="Collapsed">
            <StackPanel Margin="0,0,10,12">
                <!-- a batch: its rows (click one to inspect it) -->
                <StackPanel x:Name="BatchPanel" Visibility="Collapsed" Margin="0,0,0,12">
                    <TextBlock Style="{StaticResource Heading}" Text="Batch Scrubber Queue" />
                    <TextBlock x:Name="BatchSummary" Margin="0,4,0,8" TextWrapping="Wrap" Foreground="{DynamicResource Dim}" />
                    <Grid x:Name="BatchHeader" Margin="9,0,9,4" TextElement.Foreground="{DynamicResource Dim}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="74" />
                            <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="File" />
                        <TextBlock Grid.Column="1" Text="Format" />
                        <TextBlock Grid.Column="2" Text="Size" TextAlignment="Right" Margin="0,0,12,0" />
                        <TextBlock Grid.Column="3" Text="GPS" />
                        <TextBlock Grid.Column="4" Text="Trailer" />
                        <TextBlock Grid.Column="5" Text="Status" />
                    </Grid>
                    <ListBox x:Name="BatchList" Style="{StaticResource Rows}" ItemTemplate="{StaticResource BatchRow}" MaxHeight="232" MinHeight="60" SelectionMode="Single" AutomationProperties.Name="The batch's files" />
                    <TextBlock x:Name="BatchProgress" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Dim}" Visibility="Collapsed" />
                </StackPanel>

                <!-- the picture (what this PC can show of it) -->
                <Border x:Name="PreviewFrame" Background="{DynamicResource Stage}" CornerRadius="8" Padding="10" HorizontalAlignment="Left">
                    <Image x:Name="Preview" MaxHeight="240" MaxWidth="640" Stretch="Uniform" StretchDirection="DownOnly" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="The photo" />
                </Border>
                <TextBlock x:Name="NoPreview" Visibility="Collapsed" TextWrapping="Wrap" Foreground="{DynamicResource Dim}"
                           Text="No preview: Windows can't show this one. The details below are read straight from the file." />

                <!-- the Verified Clean check of what was saved -->
                <Border x:Name="CheckBanner" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,12,0,0" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="CheckBadge" FontWeight="Bold" FontSize="15" />
                        <TextBlock x:Name="CheckSummary" Margin="0,4,0,0" TextWrapping="Wrap" />
                        <TextBlock x:Name="CheckStats" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Dim}" FontFamily="Consolas" />
                    </StackPanel>
                </Border>

                <TextBlock x:Name="Narrative" Margin="0,12,0,0" TextWrapping="Wrap" FontSize="14" />

                <Border x:Name="AiAlert" Style="{StaticResource Alert}" BorderBrush="{DynamicResource Bad}">
                    <StackPanel>
                        <TextBlock x:Name="AiTitle" Style="{StaticResource AlertTitle}" />
                        <TextBlock x:Name="AiText" Style="{StaticResource AlertBody}" />
                        <TextBlock x:Name="AiEvidence" Style="{StaticResource AlertBody}" Foreground="{DynamicResource Dim}" />
                        <TextBlock Style="{StaticResource AlertBody}" Foreground="{DynamicResource Dim}" Margin="0,6,0,0"
                                   Text="Note: Metadata markers can be removed or omitted, so absence of markers does not guarantee human creation. Google SynthID watermarks cannot be analyzed without Google's proprietary verification service." />
                    </StackPanel>
                </Border>
                <Border x:Name="C2paNote" Style="{StaticResource Alert}" BorderBrush="{DynamicResource Accent}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource AlertTitle}" Text="🔏 Content Credentials Found" />
                        <TextBlock x:Name="C2paText" Style="{StaticResource AlertBody}" />
                        <TextBlock Style="{StaticResource AlertBody}" Foreground="{DynamicResource Dim}" Margin="0,6,0,0"
                                   Text="Cameras, phones and editing apps add these as well as AI tools. Their signature isn't checked here." />
                    </StackPanel>
                </Border>
                <Border x:Name="GpsAlert" Style="{StaticResource Alert}" BorderBrush="{DynamicResource Bad}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource AlertTitle}" Text="📍 Embedded GPS Location Found" />
                        <TextBlock x:Name="GpsText" Style="{StaticResource AlertBody}" FontFamily="Consolas" />
                        <Button x:Name="CopyGpsButton" Content="Copy coordinates" HorizontalAlignment="Left" Margin="0,8,0,0" Click="OnCopyGps" ToolTip="The coordinates as two numbers, for a map" />
                        <TextBlock Style="{StaticResource AlertBody}" Foreground="{DynamicResource Dim}" Margin="0,6,0,0" Text="No map tiles loaded. Coordinates never leave this PC." />
                    </StackPanel>
                </Border>
                <Border x:Name="ThumbAlert" Style="{StaticResource Alert}" BorderBrush="{DynamicResource Warn}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource AlertTitle}" Text="⚠️ Embedded Thumbnail Found" />
                        <TextBlock Style="{StaticResource AlertBody}" Text="This file contains an embedded preview thumbnail. If the photo was cropped or edited, the thumbnail may still show the original." />
                        <Image x:Name="Thumbnail" MaxHeight="120" MaxWidth="240" HorizontalAlignment="Left" Margin="0,8,0,0" Stretch="Uniform" StretchDirection="DownOnly" AutomationProperties.Name="The thumbnail inside the file" />
                    </StackPanel>
                </Border>
                <Border x:Name="TrailerAlert" Style="{StaticResource Alert}" BorderBrush="{DynamicResource Warn}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource AlertTitle}" Text="⚠️ Hidden Trailing Data Detected" />
                        <TextBlock x:Name="TrailerText" Style="{StaticResource AlertBody}" />
                    </StackPanel>
                </Border>

                <!-- the Metadata Inspector -->
                <DockPanel Margin="0,20,0,8">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <ToggleButton x:Name="SummaryButton" Style="{StaticResource Toggle}" Content="Summary" Click="OnSummary" IsChecked="True" Margin="0,0,6,0" />
                        <ToggleButton x:Name="TagsButton" Style="{StaticResource Toggle}" Content="All Tags Tree" Click="OnAllTags" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Heading}" Text="Metadata Inspector" VerticalAlignment="Center" />
                </DockPanel>
                <TextBox x:Name="Filter" Style="{StaticResource Placeheld}" Tag="Filter tags (e.g. Lens, Make)..." TextChanged="OnFilter" Visibility="Collapsed" Margin="0,0,0,8"
                         AutomationProperties.Name="Filter tags" />
                <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="4">
                    <StackPanel x:Name="Table" />
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
