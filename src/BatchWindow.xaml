<Window x:Class="B0r3dDeRes.BatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Batch" Width="640" Height="760" MinWidth="520" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        Icon="/b0r3dDeRes;component/assets/b0r3dDeRes.ico"
        Background="{DynamicResource Back}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI" FontSize="13" AllowDrop="True" PreviewDragEnter="OnDragOver" PreviewDragOver="OnDragOver" PreviewDrop="OnDrop"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Grid x:Name="Root" Background="{DynamicResource Back}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="24,18,24,0">
            <TextBlock Text="Batch" FontFamily="Courier New" FontWeight="Bold" FontSize="20" />
            <TextBlock x:Name="LookLine" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource Dim}" />
        </StackPanel>

        <ScrollViewer x:Name="Scroll" Grid.Row="1" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel Margin="24,0,24,12">
                <!-- the pictures -->
                <TextBlock Style="{StaticResource Label}" Margin="0,4,0,6" Text="Pictures" />
                <WrapPanel>
                    <Button x:Name="FolderButton" Content="Choose a _folder…" Click="OnChooseFolder" Margin="0,0,8,6" />
                    <Button x:Name="PicturesButton" Content="Choose _pictures…" Click="OnChoosePictures" Margin="0,0,8,6" />
                    <Button x:Name="ClearButton" Content="Clear" Click="OnClear" Margin="0,0,0,6" />
                </WrapPanel>
                <TextBlock x:Name="PicturesLine" TextWrapping="Wrap" Margin="0,4,0,0" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                           Text="Or drop a folder or pictures on this window. A folder gives its own pictures, not those in the folders inside it." />

                <!-- what to make of each -->
                <TextBlock Style="{StaticResource Label}" Margin="0,16,0,6" Text="Make" />
                <UniformGrid Columns="2">
                    <RadioButton x:Name="PngChoice" Style="{StaticResource Segment}" GroupName="Make" Content="A PNG each" IsChecked="True" Margin="0,0,6,6" Checked="OnMakeChoice" />
                    <RadioButton x:Name="WallpaperChoice" Style="{StaticResource Segment}" GroupName="Make" Content="A wallpaper each" Margin="0,0,0,6" Checked="OnMakeChoice" />
                    <RadioButton x:Name="GifChoice" Style="{StaticResource Segment}" GroupName="Make" Content="A GIF each" Checked="OnMakeChoice" />
                    <RadioButton x:Name="ApngChoice" Style="{StaticResource Segment}" GroupName="Make" Content="An APNG each" Margin="0" Checked="OnMakeChoice" />
                </UniformGrid>
                <ComboBox x:Name="WallpaperBox" Margin="0,8,0,0" Visibility="Collapsed" SelectionChanged="OnWallpaperChoice" AutomationProperties.Name="Wallpaper size" />
                <TextBlock x:Name="MakeLine" Style="{StaticResource Hint}" TextWrapping="Wrap" />
                <CheckBox x:Name="MachineFileBox" Margin="0,10,0,0" Visibility="Collapsed" />

                <!-- where they go -->
                <TextBlock Style="{StaticResource Label}" Margin="0,16,0,6" Text="Into" />
                <DockPanel>
                    <Button x:Name="IntoButton" DockPanel.Dock="Right" Content="Ch_ange…" Click="OnChooseInto" Margin="8,0,0,0" />
                    <TextBlock x:Name="IntoLine" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>

                <!-- asked once, for all of them -->
                <TextBlock Style="{StaticResource Label}" Margin="0,16,0,6" Text="A file that's already there" />
                <UniformGrid Rows="1">
                    <RadioButton x:Name="NumberChoice" Style="{StaticResource Segment}" GroupName="Clash" Content="Number the new one" IsChecked="True" Padding="0" />
                    <RadioButton x:Name="ReplaceChoice" Style="{StaticResource Segment}" GroupName="Clash" Content="Replace it" Padding="0" />
                    <RadioButton x:Name="SkipChoice" Style="{StaticResource Segment}" GroupName="Clash" Content="Skip it" Padding="0" Margin="0" />
                </UniformGrid>
                <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                           Text="Several pictures are made at once, on every core. Every file is written whole, then read back from the disk to check it." />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
            <StackPanel Margin="24,10,24,16">
                <TextBlock x:Name="StatusLine" TextWrapping="Wrap" MinHeight="18" AutomationProperties.LiveSetting="Polite" />
                <ProgressBar x:Name="Progress" Height="6" Margin="0,6,0,0" Visibility="Collapsed" />
                <ItemsControl x:Name="OutcomeList" Margin="0,4,0,0" AutomationProperties.Name="Pictures that didn't come out" />
                <DockPanel Margin="0,10,0,0" LastChildFill="False">
                    <Button x:Name="MakeButton" DockPanel.Dock="Left" Content="_Make the files" Click="OnMake" IsEnabled="False" />
                    <Button x:Name="StopButton" DockPanel.Dock="Left" Content="Stop" Click="OnStop" Margin="8,0,0,0" Visibility="Collapsed" />
                    <Button x:Name="CloseButton" DockPanel.Dock="Right" Content="Close" IsCancel="True" Click="OnClose" />
                    <Button x:Name="ShowFilesButton" DockPanel.Dock="Right" Content="Show the f_iles" Click="OnShowFiles" Margin="0,0,8,0" Visibility="Collapsed" />
                </DockPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
