<Window x:Class="B0r3dDeRes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:B0r3dDeRes"
        Title="b0r3d DeRes" Width="1280" Height="800" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Icon="/b0r3dDeRes;component/assets/b0r3dDeRes.ico"
        Background="{DynamicResource Back}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        AllowDrop="True" PreviewDragEnter="OnPreviewDragOver" PreviewDragOver="OnPreviewDragOver" PreviewDrop="OnPreviewDrop"
        DragEnter="OnDragElsewhere" DragOver="OnDragElsewhere" Drop="OnDragElsewhere"
        PreviewKeyDown="OnPreviewKeys" PreviewKeyUp="OnPreviewKeysUp" KeyDown="OnKeys">

    <Window.CommandBindings>
        <CommandBinding Command="{x:Static local:Commands.OpenPicture}" Executed="OnOpenPicture" />
        <CommandBinding Command="{x:Static local:Commands.DeresScreen}" Executed="OnDeresScreen" CanExecute="WhenNotSnipping" />
        <CommandBinding Command="{x:Static local:Commands.Batch}" Executed="OnBatch" />
        <CommandBinding Command="{x:Static local:Commands.PastePicture}" Executed="OnPastePicture" />
        <CommandBinding Command="{x:Static local:Commands.SavePng}" Executed="OnSavePng" CanExecute="WhenThereIsAPicture" />
        <CommandBinding Command="{x:Static local:Commands.CopyPicture}" Executed="OnCopyPicture" CanExecute="WhenThereIsAPicture" />
        <CommandBinding Command="{x:Static local:Commands.ZoomIn}" Executed="OnZoomIn" CanExecute="WhenThereIsAPicture" />
        <CommandBinding Command="{x:Static local:Commands.ZoomOut}" Executed="OnZoomOut" CanExecute="WhenThereIsAPicture" />
        <CommandBinding Command="{x:Static local:Commands.ZoomFit}" Executed="OnZoomFit" CanExecute="WhenThereIsAPicture" />
        <CommandBinding Command="{x:Static local:Commands.ZoomOne}" Executed="OnZoomOne" CanExecute="WhenThereIsAPicture" />
        <CommandBinding Command="{x:Static local:Commands.Compare}" Executed="OnCompare" CanExecute="WhenThereIsAnOriginal" />
        <CommandBinding Command="{x:Static local:Commands.FullScreen}" Executed="OnFullScreen" CanExecute="WhenThereIsAPicture" />
        <CommandBinding Command="{x:Static local:Commands.About}" Executed="OnAbout" />
    </Window.CommandBindings>

    <DockPanel x:Name="Root" Background="{DynamicResource Back}">
        <!-- Access keys: F E V H on the bar, D U B J for the tabs; on the DeRes tab I W A T G N X for
             the sections, O, S, C, L, M (Surprise me), K, R and P (Play) on buttons (Grab palette
             has none: B is the EXIF Scrubber's, and the Edit menu has it); each menu list has its
             own (each tab's lines unique among the lines it shows). -->
        <Menu x:Name="MenuBar" DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Open picture or video…" Command="{x:Static local:Commands.OpenPicture}" />
                <MenuItem x:Name="SamplesMenu" Header="Open a sa_mple" />
                <MenuItem Header="DeRes the scree_n…" Command="{x:Static local:Commands.DeresScreen}" />
                <MenuItem x:Name="CameraMenu" Header="Use the _camera" Click="OnUseCamera" />
                <MenuItem x:Name="BatchMenu" Header="_Batch: a folder or several pictures…" Command="{x:Static local:Commands.Batch}" />
                <MenuItem x:Name="OpenLookMenu" Header="Open _look…" Click="OnOpenLook" />
                <MenuItem x:Name="OpenPaletteMenu" Header="Open p_alette…" Click="OnLoadPalette" />
                <!-- the EXIF tools' (on their tabs) -->
                <MenuItem x:Name="ExifAddMenu" Header="_Add photos or videos to the batch…" Click="OnExifAddFiles" Visibility="Collapsed" />
                <MenuItem x:Name="ExifFolderMenu" Header="Add a _folder to the batch…" InputGestureText="Ctrl+B" Click="OnExifAddFolder" Visibility="Collapsed" />
                <Separator />
                <MenuItem x:Name="SavePngMenu" Header="_Save PNG…" Command="{x:Static local:Commands.SavePng}" />
                <MenuItem x:Name="SaveGifMenu" Header="Save _GIF…" Click="OnSaveGif" />
                <MenuItem x:Name="SaveApngMenu" Header="Save A_PNG…" Click="OnSaveApng" />
                <MenuItem x:Name="SaveMp4Menu" Header="Save MP_4…" Click="OnSaveMp4" />
                <MenuItem x:Name="SaveFramesMenu" Header="Save PNG f_rames…" Click="OnSaveFrames" />
                <MenuItem x:Name="WallpaperMenu" Header="Save _wallpaper" />
                <MenuItem x:Name="EmulatorMenu" Header="Save for an _emulator…" Click="OnSaveEmulator" />
                <MenuItem x:Name="SaveLookMenu" Header="Save loo_k…" Click="OnSaveLook" />
                <MenuItem x:Name="SavePaletteMenu" Header="Save pale_tte…" Click="OnSavePalette" />
                <!-- the ASCII studio's (on its tab) -->
                <MenuItem x:Name="AsciiAnsMenu" Header="Save ._ANS with SAUCE…" Click="OnAsciiAnsMenu" Visibility="Collapsed" />
                <MenuItem x:Name="AsciiAnsimationMenu" Header="Save ANS_Imation…" Click="OnAsciiAnsimationMenu" Visibility="Collapsed" />
                <MenuItem x:Name="AsciiSeqMenu" Header="Save .SE_Q for a C64…" Click="OnAsciiSeqMenu" Visibility="Collapsed" />
                <MenuItem x:Name="AsciiPrgMenu" Header="Save .P_RG for a C64…" Click="OnAsciiPrgMenu" Visibility="Collapsed" />
                <MenuItem x:Name="AsciiTxtMenu" Header="Save Teletext as ._TXT…" Click="OnAsciiTxtMenu" Visibility="Collapsed" />
                <MenuItem x:Name="ExifSaveMenu" Header="_Save a clean copy…" InputGestureText="Ctrl+S" Click="OnExifSaveMenu" Visibility="Collapsed" />
                <MenuItem x:Name="ExifZipMenu" Header="Clean the batch into a _ZIP…" Click="OnScrubZip" Visibility="Collapsed" />
                <MenuItem x:Name="ExifIntoMenu" Header="Clean the batch into a folde_r…" Click="OnScrubInto" Visibility="Collapsed" />
                <MenuItem x:Name="ExifClearMenu" Header="C_lear the batch" Click="OnExifClearBatch" Visibility="Collapsed" />
                <Separator />
                <MenuItem Header="E_xit" InputGestureText="Alt+F4" Click="OnExit" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem x:Name="CopyMenu" Header="_Copy picture" Command="{x:Static local:Commands.CopyPicture}" InputGestureText="Ctrl+C" />
                <MenuItem x:Name="ExifCopyGpsMenu" Header="_Copy coordinates" InputGestureText="Ctrl+C" Click="OnExifCopyGps" Visibility="Collapsed" />
                <MenuItem x:Name="AsciiCopyMarkdownMenu" Header="Copy as _Markdown" Tag="markdown" Click="OnAsciiCopyMenu" Visibility="Collapsed" />
                <MenuItem x:Name="AsciiCopyAnsiMenu" Header="Copy as A_NSI escapes" Tag="ansi" Click="OnAsciiCopyMenu" Visibility="Collapsed" />
                <MenuItem x:Name="AsciiCopyHtmlMenu" Header="Copy as _HTML" Tag="html" Click="OnAsciiCopyMenu" Visibility="Collapsed" />
                <MenuItem Header="_Paste picture or link" Command="{x:Static local:Commands.PastePicture}" InputGestureText="Ctrl+V" />
                <Separator x:Name="DeresEditLine" />
                <MenuItem x:Name="CopyLinkMenu" Header="Copy share _link" Click="OnCopyLink" />
                <MenuItem x:Name="GrabMenu" Header="_Grab palette" Click="OnGrabPalette" />
                <MenuItem x:Name="SurpriseMenu" Header="S_urprise me" Click="OnSurprise" />
                <Separator />
                <MenuItem Header="_Reset settings…" Click="OnResetMenu" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem x:Name="ZoomInMenu" Header="Zoom _in" Command="{x:Static local:Commands.ZoomIn}" InputGestureText="Ctrl++" />
                <MenuItem x:Name="ZoomOutMenu" Header="Zoom _out" Command="{x:Static local:Commands.ZoomOut}" InputGestureText="Ctrl+-" />
                <MenuItem x:Name="FitMenu" Header="_Fit" Command="{x:Static local:Commands.ZoomFit}" />
                <MenuItem x:Name="OneMenu" Header="_1 screen pixel a pixel" Command="{x:Static local:Commands.ZoomOne}" />
                <Separator x:Name="ViewLine1" />
                <MenuItem x:Name="CompareMenu" Header="_Compare" Command="{x:Static local:Commands.Compare}" IsCheckable="False" />
                <MenuItem x:Name="ScanlinesMenu" Header="_Scanlines over the art" Click="OnScanlinesMenu" Visibility="Collapsed" />
                <MenuItem x:Name="FullScreenMenu" Header="F_ull screen" Command="{x:Static local:Commands.FullScreen}" />
                <MenuItem x:Name="PlayMenu" Header="_Play or pause" Click="OnPlayMenu" />
                <Separator x:Name="ViewLine2" />
                <MenuItem Header="_Look">
                    <MenuItem x:Name="LookWindows" Header="Like _Windows" IsCheckable="True" Tag="Windows" Click="OnLook" />
                    <MenuItem x:Name="LookLight" Header="_Light" IsCheckable="True" Tag="Light" Click="OnLook" />
                    <MenuItem x:Name="LookDark" Header="_Dark" IsCheckable="True" Tag="Dark" Click="OnLook" />
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About b0r3d DeRes" Command="{x:Static local:Commands.About}" />
                <Separator />
                <MenuItem Header="_img.b0r3d.org, the website" Click="OnWebsite" />
                <MenuItem Header="b0r3d._org" Click="OnMaker" />
            </MenuItem>
        </Menu>

        <!-- the bottom line: notes on the left, the version on the right -->
        <Border x:Name="BottomLine" DockPanel.Dock="Bottom" Background="{DynamicResource MenuBar}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="14,5">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource Dim}" Margin="16,0,0,0">
                    <Run x:Name="VersionRun" /><Run Text=" · " /><Hyperlink Click="OnMaker">b0r3d.org</Hyperlink>
                </TextBlock>
                <TextBlock x:Name="Note" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <Grid>
            <TabControl x:Name="Tabs" Padding="236,4,14,0">
                <TabItem x:Name="DeresTab" Header="_DeRes">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="PanelColumn" Width="370" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- the settings, in fold-out sections like the website's -->
                        <Border x:Name="Panel" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
                            <ScrollViewer x:Name="PanelScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                <StackPanel Margin="20,10,20,20">
                                    <TextBlock Style="{StaticResource Hint}" Margin="0" FontFamily="Courier New"
                                               Text="Retro looks for your pictures. They stay on this PC." />

                                    <Expander x:Name="ImageSection" Style="{StaticResource Section}" Header="_Image" IsExpanded="True">
                                        <StackPanel>
                                            <Button x:Name="OpenButton" Content="_Open picture or video…" Command="{x:Static local:Commands.OpenPicture}" HorizontalAlignment="Stretch" />
                                            <!-- the live camera: Use camera, then (while it's on) Snap, Record 3 s, Flip, Mirror and Stop -->
                                            <Button x:Name="CameraButton" Content="Use camera" Click="OnUseCamera" HorizontalAlignment="Stretch" Margin="0,8,0,0"
                                                    ToolTip="Your camera, live through the look: Snap or Record 3 s makes it the picture" />
                                            <StackPanel x:Name="CameraPanel" Visibility="Collapsed">
                                                <Button x:Name="SnapButton" Content="Snap" Click="OnSnap" HorizontalAlignment="Stretch"
                                                        ToolTip="The camera's picture as it is now becomes the picture, and the camera turns off" />
                                                <UniformGrid Rows="1" Margin="0,8,0,0">
                                                    <Button x:Name="RecordButton" Content="Record 3 s" Click="OnRecord" Margin="0,0,3,0"
                                                            ToolTip="Three seconds at ten frames a second, opened like an animated GIF" />
                                                    <Button x:Name="FlipButton" Content="Flip" Click="OnFlip" Margin="3,0,3,0" Visibility="Collapsed"
                                                            ToolTip="The next camera" AutomationProperties.Name="The next camera" />
                                                    <ToggleButton x:Name="MirrorButton" Style="{StaticResource Toggle}" Content="Mirror" Click="OnMirror" Margin="3,0,3,0"
                                                                  ToolTip="Left and right swapped, as a mirror shows you (the snap and the clip too)" />
                                                    <Button x:Name="StopCameraButton" Content="Stop" Click="OnStopCamera" Margin="3,0,0,0"
                                                            ToolTip="The camera off, and the picture back" AutomationProperties.Name="Stop the camera" />
                                                </UniformGrid>
                                            </StackPanel>
                                            <TextBlock x:Name="CameraLine" Style="{StaticResource Hint}" Margin="0,6,0,0" TextWrapping="Wrap" />
                                            <UniformGrid x:Name="SnipRow" Rows="1" Margin="0,8,0,0">
                                                <Button x:Name="SnipButton" Content="DeRes the screen…" Command="{x:Static local:Commands.DeresScreen}" Margin="0,0,4,0"
                                                        ToolTip="A box of the screen, a whole screen or all of them becomes the picture (Ctrl+Shift+D)" />
                                                <Button x:Name="BatchButton" Content="Batch…" Command="{x:Static local:Commands.Batch}" Margin="4,0,0,0"
                                                        ToolTip="A folder or several pictures through this look into a folder (Ctrl+B)" />
                                            </UniformGrid>
                                            <TextBlock x:Name="SampleLine" Style="{StaticResource Hint}" Margin="0,8,0,0" />
                                            <TextBlock x:Name="DropHint" Style="{StaticResource Hint}" Margin="0,2,0,0" TextWrapping="Wrap"
                                                       Text="Or drop a picture or a video on the window, or paste a picture. Drop a folder, or several pictures or videos, for a batch." />
                                            <TextBlock x:Name="PictureInfo" Margin="0,10,0,0" TextWrapping="Wrap" FontWeight="SemiBold" />

                                            <TextBlock Style="{StaticResource Label}" Text="Resolution" />
                                            <UniformGrid Rows="1">
                                                <RadioButton x:Name="NativeButton" Style="{StaticResource Segment}" GroupName="Resolution" Content="Native" Checked="OnResolution" AutomationProperties.Name="Native resolution" />
                                                <RadioButton x:Name="CustomButton" Style="{StaticResource Segment}" GroupName="Resolution" Content="Custom size" Margin="0" Checked="OnResolution" AutomationProperties.Name="Custom size" />
                                            </UniformGrid>
                                            <StackPanel x:Name="WidthPanel" Visibility="Collapsed" Margin="0,10,0,0">
                                                <DockPanel>
                                                    <TextBlock Text="Width" Width="52" VerticalAlignment="Center" Foreground="{DynamicResource Dim}" />
                                                    <TextBox x:Name="WidthBox" Width="70" TextChanged="OnWidthTyped" LostKeyboardFocus="OnWidthLeft" KeyDown="OnWidthKey" AutomationProperties.Name="Custom width in pixels" />
                                                    <TextBlock x:Name="WidthHeight" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Dim}" />
                                                </DockPanel>
                                                <Slider x:Name="WidthSlider" Minimum="0" Maximum="1000" SmallChange="1" LargeChange="50" Margin="0,6,0,0" ValueChanged="OnWidthSlider" AutomationProperties.Name="Width" />
                                            </StackPanel>
                                            <TextBlock x:Name="ResolutionInfo" Style="{StaticResource Hint}" />

                                            <StackPanel x:Name="FitPanel">
                                                <TextBlock Style="{StaticResource Label}" Text="Framing" />
                                                <UniformGrid Rows="1">
                                                    <RadioButton x:Name="FitFill" Style="{StaticResource Segment}" GroupName="Framing" Content="Crop to fill" Tag="fill" Padding="0" Checked="OnFraming" AutomationProperties.Name="Crop to fill" />
                                                    <RadioButton x:Name="FitFit" Style="{StaticResource Segment}" GroupName="Framing" Content="Fit, with bars" Tag="fit" Padding="0" Checked="OnFraming" AutomationProperties.Name="Fit, with bars" />
                                                    <RadioButton x:Name="FitStretch" Style="{StaticResource Segment}" GroupName="Framing" Content="Stretch" Tag="stretch" Margin="0" Checked="OnFraming" AutomationProperties.Name="Stretch" />
                                                </UniformGrid>
                                            </StackPanel>

                                            <DockPanel Margin="0,12,0,0">
                                                <TextBlock x:Name="DetailValue" DockPanel.Dock="Right" />
                                                <TextBlock Text="Detail" Foreground="{DynamicResource Dim}" />
                                            </DockPanel>
                                            <Slider x:Name="DetailSlider" Minimum="0" Maximum="20" SmallChange="1" LargeChange="2" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnDetail" AutomationProperties.Name="Detail" />
                                            <TextBlock x:Name="DetailHint" Style="{StaticResource Hint}" />

                                            <StackPanel x:Name="BackgroundPanel" Visibility="Collapsed">
                                                <TextBlock Style="{StaticResource Label}" Text="Transparent areas" />
                                                <UniformGrid Rows="1">
                                                    <RadioButton x:Name="BackWhite" Style="{StaticResource Segment}" GroupName="Background" Content="White" Tag="white" Checked="OnBackground" AutomationProperties.Name="Transparent areas on white" />
                                                    <RadioButton x:Name="BackBlack" Style="{StaticResource Segment}" GroupName="Background" Content="Black" Tag="black" Checked="OnBackground" AutomationProperties.Name="Transparent areas on black" />
                                                    <RadioButton x:Name="BackKeep" Style="{StaticResource Segment}" GroupName="Background" Content="Keep" Tag="transparent" Margin="0" Checked="OnBackground" AutomationProperties.Name="Keep transparent areas see-through" />
                                                </UniformGrid>
                                                <TextBlock x:Name="KeepNote" Style="{StaticResource Hint}" Visibility="Collapsed" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Expander>

                                    <Expander x:Name="HardwareSection" Style="{StaticResource Section}" Header="Hard_ware">
                                        <StackPanel>
                                            <Button x:Name="SurpriseButton" Content="Surprise _me" Click="OnSurprise" HorizontalAlignment="Stretch" Margin="0,0,0,10"
                                                    ToolTip="A random machine, dither and adjustments" />
                                            <UniformGrid x:Name="Cards" Columns="2" Margin="0,0,-6,0" />
                                            <TextBlock x:Name="AboutLine" Style="{StaticResource Hint}" Margin="0,4,0,0" />
                                            <!-- the tile meter: would it fit the machine? -->
                                            <Border x:Name="TileFit" Visibility="Collapsed" Margin="0,8,0,0" Padding="10,6" CornerRadius="4" BorderThickness="1" Background="{DynamicResource Field}">
                                                <TextBlock x:Name="TileFitText" FontFamily="Consolas" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                                            </Border>
                                            <!-- the machines that pick their colours from the picture -->
                                            <StackPanel x:Name="PaletteTools" Visibility="Collapsed" Margin="0,12,0,0">
                                                <StackPanel x:Name="ColoursPanel">
                                                    <DockPanel>
                                                        <TextBlock x:Name="ColoursValue" DockPanel.Dock="Right" />
                                                        <TextBlock Text="Colours" Foreground="{DynamicResource Dim}" />
                                                    </DockPanel>
                                                    <Slider x:Name="ColoursSlider" Minimum="2" Maximum="256" SmallChange="1" LargeChange="8" IsSnapToTickEnabled="True" TickFrequency="1"
                                                            ValueChanged="OnColours" AutomationProperties.Name="Colours" />
                                                </StackPanel>
                                                <WrapPanel Margin="0,8,0,0">
                                                    <Button x:Name="LoadPaletteButton" Content="_Load palette…" Click="OnLoadPalette" Margin="0,0,8,6" ToolTip=".hex, .pal, .gpl or a palette .png" />
                                                    <Button x:Name="GrabPaletteButton" Content="Grab palette" Click="OnGrabPalette" Margin="0,0,0,6" ToolTip="Pick the colours from the picture" />
                                                </WrapPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </Expander>

                                    <Expander x:Name="AdjustSection" Style="{StaticResource Section}" Header="_Adjust">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock x:Name="BrightnessValue" DockPanel.Dock="Right" />
                                                <TextBlock Text="Brightness" Foreground="{DynamicResource Dim}" />
                                            </DockPanel>
                                            <Slider x:Name="BrightnessSlider" Minimum="-50" Maximum="50" SmallChange="1" LargeChange="10" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnAdjust" AutomationProperties.Name="Brightness" />
                                            <DockPanel Margin="0,8,0,0">
                                                <TextBlock x:Name="ContrastValue" DockPanel.Dock="Right" />
                                                <TextBlock Text="Contrast" Foreground="{DynamicResource Dim}" />
                                            </DockPanel>
                                            <Slider x:Name="ContrastSlider" Minimum="0" Maximum="200" SmallChange="1" LargeChange="10" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnAdjust" AutomationProperties.Name="Contrast" />
                                            <DockPanel Margin="0,8,0,0">
                                                <TextBlock x:Name="SaturationValue" DockPanel.Dock="Right" />
                                                <TextBlock Text="Saturation" Foreground="{DynamicResource Dim}" />
                                            </DockPanel>
                                            <Slider x:Name="SaturationSlider" Minimum="0" Maximum="200" SmallChange="1" LargeChange="10" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnAdjust" AutomationProperties.Name="Saturation" />
                                            <DockPanel Margin="0,8,0,0">
                                                <TextBlock x:Name="GammaValue" DockPanel.Dock="Right" />
                                                <TextBlock Text="Gamma" Foreground="{DynamicResource Dim}" />
                                            </DockPanel>
                                            <Slider x:Name="GammaSlider" Minimum="40" Maximum="250" SmallChange="1" LargeChange="10" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnAdjust" AutomationProperties.Name="Gamma" />
                                            <Button x:Name="AdjustReset" Content="Reset" Click="OnAdjustReset" HorizontalAlignment="Left" Margin="0,12,0,0" AutomationProperties.Name="Reset the adjustments" />
                                        </StackPanel>
                                    </Expander>

                                    <Expander x:Name="DitherSection" Style="{StaticResource Section}" Header="Di_ther">
                                        <StackPanel>
                                            <TextBlock x:Name="DitherNote" Style="{StaticResource Hint}" Margin="0,0,0,8" Visibility="Collapsed" />
                                            <StackPanel x:Name="Dithers" />
                                        </StackPanel>
                                    </Expander>

                                    <Expander x:Name="SignalSection" Style="{StaticResource Section}" Header="Si_gnal">
                                        <StackPanel>
                                            <!-- the buttons, in two rows of four columns: Machine's own takes two -->
                                            <Grid x:Name="SignalButtons" Margin="0,0,-6,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition />
                                                    <ColumnDefinition />
                                                    <ColumnDefinition />
                                                    <ColumnDefinition />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                            </Grid>
                                            <TextBlock x:Name="SignalNote" Style="{StaticResource Hint}" Margin="0,2,0,0" />
                                            <!-- while it's on -->
                                            <StackPanel x:Name="SignalPanel">
                                                <DockPanel Margin="0,12,0,0">
                                                    <TextBlock x:Name="WearValue" DockPanel.Dock="Right" />
                                                    <TextBlock Text="Wear" Foreground="{DynamicResource Dim}" />
                                                </DockPanel>
                                                <Slider x:Name="WearSlider" Minimum="0" Maximum="100" SmallChange="5" LargeChange="10" IsSnapToTickEnabled="True" TickFrequency="5" ValueChanged="OnSignalSlider" AutomationProperties.Name="Wear" />
                                                <Expander x:Name="SignalAdvanced" Style="{StaticResource SubSection}" Header="Advanced" Margin="0,10,0,0">
                                                    <StackPanel>
                                                        <DockPanel>
                                                            <TextBlock x:Name="SignalColourValue" DockPanel.Dock="Right" />
                                                            <TextBlock Text="Colour" Foreground="{DynamicResource Dim}" />
                                                        </DockPanel>
                                                        <Slider x:Name="SignalColourSlider" Minimum="0" Maximum="150" SmallChange="5" LargeChange="10" IsSnapToTickEnabled="True" TickFrequency="5" ValueChanged="OnSignalSlider" AutomationProperties.Name="Signal colour" />
                                                        <DockPanel Margin="0,8,0,0">
                                                            <TextBlock x:Name="SharpenValue" DockPanel.Dock="Right" />
                                                            <TextBlock Text="Sharpen" Foreground="{DynamicResource Dim}" />
                                                        </DockPanel>
                                                        <Slider x:Name="SharpenSlider" Minimum="0" Maximum="100" SmallChange="5" LargeChange="10" IsSnapToTickEnabled="True" TickFrequency="5" ValueChanged="OnSignalSlider" AutomationProperties.Name="Sharpen" />
                                                        <TextBlock Style="{StaticResource Label}" Text="TV decoder" />
                                                        <UniformGrid Rows="1">
                                                            <RadioButton x:Name="DecoderNotch" Style="{StaticResource Segment}" GroupName="Decoder" Content="Simple" Tag="notch" Checked="OnDecoder" AutomationProperties.Name="Simple TV decoder" />
                                                            <RadioButton x:Name="DecoderComb" Style="{StaticResource Segment}" GroupName="Decoder" Content="Comb filter" Tag="comb" Margin="0" Checked="OnDecoder" AutomationProperties.Name="Comb filter TV decoder" />
                                                        </UniformGrid>
                                                        <TextBlock Style="{StaticResource Hint}"
                                                                   Text="A comb filter cleans up the colour fringes, and with them the colours that only exist in the signal (CGA, Apple II)." />
                                                        <!-- the tape's extras: copies, presets, and every one of the engine's settings -->
                                                        <DockPanel Margin="0,12,0,0">
                                                            <TextBlock x:Name="DubsValue" DockPanel.Dock="Right" />
                                                            <TextBlock Text="Dub it" Foreground="{DynamicResource Dim}" />
                                                        </DockPanel>
                                                        <Slider x:Name="DubsSlider" Minimum="0" Maximum="9" SmallChange="1" LargeChange="1" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnDubs"
                                                                AutomationProperties.Name="Dub it, copies of the tape" />
                                                        <TextBlock Style="{StaticResource Hint}" Text="Each copy goes through it all again, as a tape copied from a tape: a little worse each time." />
                                                        <TextBlock Style="{StaticResource Label}" Text="Presets" />
                                                        <ComboBox x:Name="PresetBox" SelectionChanged="OnPreset" AutomationProperties.Name="Signal presets" />
                                                        <WrapPanel Margin="0,8,0,0">
                                                            <Button x:Name="SavePresetButton" Content="Save as preset…" Click="OnSavePreset" Margin="0,0,8,6" ToolTip="Keep this Signal (connection, wear, every setting, copies) under a name" />
                                                            <Button x:Name="DeletePresetButton" Content="Delete preset" Click="OnDeletePreset" Margin="0,0,0,6" ToolTip="Delete your preset that's on now" />
                                                        </WrapPanel>
                                                        <Button x:Name="EverySettingButton" Content="Every setting…" Click="OnEverySetting" HorizontalAlignment="Stretch" Margin="0,4,0,0"
                                                                ToolTip="All of ntsc-rs's settings, the engine behind the Signal" />
                                                        <TextBlock x:Name="EngineNote" Style="{StaticResource Hint}" Visibility="Collapsed" />
                                                    </StackPanel>
                                                </Expander>
                                            </StackPanel>
                                            <TextBlock x:Name="SignalMoves" Style="{StaticResource Hint}" Margin="0,10,0,0"
                                                       Text="The noise moves when a GIF or a video plays, and in the animations and videos under Export." />
                                            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0">
                                                <Run Text="Signal engine: " /><Hyperlink Click="OnSignalEngine" ToolTip="github.com/valadaptive/ntsc-rs (opens your browser)">ntsc-rs</Hyperlink><Run Text=" by valadaptive (MIT) · " /><Hyperlink Click="OnSignalNotices" ToolTip="Help → About">notices</Hyperlink>
                                            </TextBlock>
                                        </StackPanel>
                                    </Expander>

                                    <Expander x:Name="ScreenSection" Style="{StaticResource Section}" Header="Scree_n">
                                        <StackPanel>
                                            <UniformGrid x:Name="ScreenButtons" Columns="4" Margin="0,0,-6,0" />
                                            <!-- the CRT's (the VHS, composite and phosphor screens are CRTs too) -->
                                            <StackPanel x:Name="CrtPanel">
                                                <StackPanel x:Name="MaskPanel">
                                                    <TextBlock Style="{StaticResource Label}" Text="Mask" />
                                                    <UniformGrid Rows="1">
                                                        <RadioButton x:Name="MaskNone" Style="{StaticResource Segment}" GroupName="Mask" Content="None" Tag="none" Padding="0" Checked="OnMask" AutomationProperties.Name="No mask" />
                                                        <RadioButton x:Name="MaskShadow" Style="{StaticResource Segment}" GroupName="Mask" Content="Shadow mask" Tag="shadow" Padding="0" Checked="OnMask" AutomationProperties.Name="Shadow mask" />
                                                        <RadioButton x:Name="MaskGrille" Style="{StaticResource Segment}" GroupName="Mask" Content="Aperture grille" Tag="grille" Padding="0" Margin="0" Checked="OnMask" AutomationProperties.Name="Aperture grille" />
                                                    </UniformGrid>
                                                </StackPanel>
                                                <DockPanel Margin="0,12,0,0">
                                                    <TextBlock x:Name="ScanlinesValue" DockPanel.Dock="Right" />
                                                    <TextBlock Text="Scanlines" Foreground="{DynamicResource Dim}" />
                                                </DockPanel>
                                                <Slider x:Name="ScanlinesSlider" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnFxSlider" AutomationProperties.Name="Scanlines" />
                                                <DockPanel Margin="0,8,0,0">
                                                    <TextBlock x:Name="CurveValue" DockPanel.Dock="Right" />
                                                    <TextBlock Text="Curve" Foreground="{DynamicResource Dim}" />
                                                </DockPanel>
                                                <Slider x:Name="CurveSlider" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnFxSlider" AutomationProperties.Name="Curve" />
                                                <StackPanel x:Name="BloomPanel">
                                                    <DockPanel Margin="0,8,0,0">
                                                        <TextBlock x:Name="BloomValue" DockPanel.Dock="Right" />
                                                        <TextBlock Text="Bloom" Foreground="{DynamicResource Dim}" />
                                                    </DockPanel>
                                                    <Slider x:Name="BloomSlider" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnFxSlider" AutomationProperties.Name="Bloom" />
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel x:Name="VhsPanel">
                                                <DockPanel Margin="0,8,0,0">
                                                    <TextBlock x:Name="TrackingValue" DockPanel.Dock="Right" />
                                                    <TextBlock Text="Tracking jitter &amp; noise" Foreground="{DynamicResource Dim}" />
                                                </DockPanel>
                                                <Slider x:Name="TrackingSlider" Minimum="0" Maximum="100" SmallChange="5" LargeChange="10" IsSnapToTickEnabled="True" TickFrequency="5" ValueChanged="OnFxSlider" AutomationProperties.Name="Tracking jitter and noise" />
                                                <CheckBox x:Name="OsdBox" Content="On-screen display (PLAY ▶)" Margin="0,8,0,0" Checked="OnOsd" Unchecked="OnOsd" />
                                            </StackPanel>
                                            <StackPanel x:Name="LcdPanel">
                                                <DockPanel Margin="0,12,0,0">
                                                    <TextBlock x:Name="GridValue" DockPanel.Dock="Right" />
                                                    <TextBlock Text="Pixel grid" Foreground="{DynamicResource Dim}" />
                                                </DockPanel>
                                                <Slider x:Name="GridSlider" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnFxSlider" AutomationProperties.Name="Pixel grid" />
                                                <DockPanel Margin="0,8,0,0">
                                                    <TextBlock x:Name="GhostValue" DockPanel.Dock="Right" />
                                                    <TextBlock Text="Ghosting" Foreground="{DynamicResource Dim}" />
                                                </DockPanel>
                                                <Slider x:Name="GhostSlider" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnFxSlider" AutomationProperties.Name="Ghosting" />
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                                       Text="For the preview. To keep it in the PNG, tick &quot;With the screen effect&quot; under Export (3× and up)." />
                                        </StackPanel>
                                    </Expander>

                                    <Expander x:Name="ExportSection" Style="{StaticResource Section}" Header="E_xport">
                                        <StackPanel>
                                            <StackPanel x:Name="ShapePanel">
                                                <TextBlock Style="{StaticResource Label}" Margin="0,0,0,4" Text="Pixel shape" />
                                                <UniformGrid Rows="1">
                                                    <RadioButton x:Name="ShapeRaw" Style="{StaticResource Segment}" GroupName="Shape" Content="Raw pixels" Checked="OnShape" AutomationProperties.Name="Raw pixels" />
                                                    <RadioButton x:Name="ShapeTv" Style="{StaticResource Segment}" GroupName="Shape" Content="As on a TV" Margin="0" Checked="OnShape" AutomationProperties.Name="As on a TV" />
                                                </UniformGrid>
                                                <TextBlock x:Name="ShapeNote" Style="{StaticResource Hint}" />
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource Label}" Text="Size" />
                                            <UniformGrid x:Name="Sizes" Columns="4" Margin="0,0,-6,0" />
                                            <TextBlock x:Name="SizeLine" Margin="0,8,0,0" TextWrapping="Wrap" FontFamily="Consolas" />
                                            <CheckBox x:Name="ExportFxBox" Content="With the screen effect" Margin="0,10,0,0" Checked="OnExportFx" Unchecked="OnExportFx" />
                                            <TextBlock x:Name="LiveNote" Style="{StaticResource Hint}" Margin="0,10,0,0" Visibility="Collapsed"
                                                       Text="Snap first: saves work on a still or a clip." />
                                            <WrapPanel Margin="0,12,0,0">
                                                <Button x:Name="SaveButton" Content="_Save PNG…" Command="{x:Static local:Commands.SavePng}" Margin="0,0,8,6" />
                                                <Button x:Name="CopyButton" Content="_Copy picture" Command="{x:Static local:Commands.CopyPicture}" Margin="0,0,0,6" />
                                            </WrapPanel>
                                            <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0"
                                                       Text="Or drag the small picture under the preview into a folder or another program." />
                                            <!-- GIF and APNG: a loop of the picture, or an animated GIF's own frames -->
                                            <TextBlock Style="{StaticResource Label}" Text="Animation loop" />
                                            <UniformGrid x:Name="AnimStyles" Rows="1" Margin="0,0,-6,0" />
                                            <StackPanel x:Name="LoopRows" Visibility="Collapsed">
                                                <TextBlock Style="{StaticResource Label}" Text="Loop length" />
                                                <UniformGrid x:Name="LoopLengths" Rows="1" Margin="0,0,-6,0" />
                                                <TextBlock Style="{StaticResource Label}" Text="Loop speed" />
                                                <UniformGrid x:Name="LoopSpeeds" Rows="1" Margin="0,0,-6,0" />
                                            </StackPanel>
                                            <!-- a video's: the frame rate it goes out at, and its sound -->
                                            <StackPanel x:Name="VideoRows" Visibility="Collapsed">
                                                <TextBlock Style="{StaticResource Label}" Text="Frame rate" />
                                                <UniformGrid x:Name="VideoRates" Columns="4" Margin="0,0,-6,0" />
                                                <CheckBox x:Name="VideoKeepSound" Content="Keep the sound" Margin="0,10,0,0" Checked="OnVideoKeepSound" Unchecked="OnVideoKeepSound"
                                                          ToolTip="The MP4 keeps the video's sound, from its start to its stop" />
                                                <TextBlock x:Name="VideoHint" Style="{StaticResource Hint}" Margin="0,8,0,0" />
                                            </StackPanel>
                                            <WrapPanel Margin="0,12,0,0">
                                                <Button x:Name="SaveMp4Button" Content="Save MP4…" Click="OnSaveMp4" Margin="0,0,8,6" Visibility="Collapsed" ToolTip="The video through the look, from its start to its stop, with its sound" />
                                                <Button x:Name="SaveGifButton" Content="Save GIF…" Click="OnSaveGif" Margin="0,0,8,6" ToolTip="A looping GIF: the loop above, or an animated GIF's own frames" />
                                                <Button x:Name="SaveApngButton" Content="Save APNG…" Click="OnSaveApng" Margin="0,0,8,6" ToolTip="An animated PNG: full colour, played by browsers" />
                                                <Button x:Name="SaveFramesButton" Content="Save PNG frames…" Click="OnSaveFrames" Margin="0,0,8,6" Visibility="Collapsed" ToolTip="Every frame from its start to its stop as a numbered PNG, into a folder" />
                                                <Button x:Name="StopAnimationButton" Content="Stop" Click="OnStopAnimation" Margin="0,0,0,6" Visibility="Collapsed" AutomationProperties.Name="Stop making the animation" />
                                            </WrapPanel>
                                            <TextBlock x:Name="AnimHint" Style="{StaticResource Hint}" Margin="0,2,0,0" Visibility="Collapsed" />
                                            <!-- the website's wallpapers, and one for each of the PC's screens -->
                                            <TextBlock Style="{StaticResource Label}" Text="Wallpaper" />
                                            <UniformGrid x:Name="WallpaperButtons" Columns="2" Margin="0,0,-6,0" />
                                            <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0"
                                                       Text="Enlarged by the biggest whole step that fits, on its first colour." />
                                            <!-- the machine's own file, for emulators and editors -->
                                            <Button x:Name="EmulatorButton" Click="OnSaveEmulator" HorizontalAlignment="Stretch" Margin="0,12,0,0" Visibility="Collapsed" />
                                            <TextBlock x:Name="ExportNote" Style="{StaticResource Hint}" Visibility="Collapsed" />
                                            <Button x:Name="ShareButton" Content="Copy share lin_k" Click="OnCopyLink" HorizontalAlignment="Stretch" Margin="0,12,0,0"
                                                    ToolTip="A link that opens these settings on img.b0r3d.org (or here, pasted)" />
                                        </StackPanel>
                                    </Expander>

                                    <!-- every setting back to how a first start has them (the picture stays) -->
                                    <Button x:Name="ResetButton" Content="_Reset settings" Click="OnResetButton" HorizontalAlignment="Right" Margin="0,18,0,0" MinWidth="150" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- the picture -->
                        <Grid x:Name="StageArea" Grid.Column="1" Margin="24,18,24,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border x:Name="Stage" Background="{DynamicResource Stage}" CornerRadius="8" ClipToBounds="True">
                                <Grid>
                                    <local:PixelView x:Name="View" AutomationProperties.Name="The picture" />
                                    <TextBlock x:Name="TagOriginal" Text="Original" Style="{StaticResource Tag}" HorizontalAlignment="Left" Visibility="Collapsed" />
                                    <TextBlock x:Name="TagDeres" Text="DeRes" Style="{StaticResource Tag}" HorizontalAlignment="Right" Visibility="Collapsed" />
                                    <TextBlock x:Name="StageNote" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                               TextWrapping="Wrap" MaxWidth="420" Margin="20" Foreground="{DynamicResource Dim}" IsHitTestVisible="False" />
                                </Grid>
                            </Border>

                            <!-- an animated GIF's play bar: Play / Pause, the frame slider and its counter -->
                            <DockPanel x:Name="PlayBar" Grid.Row="1" Margin="0,10,0,0" Visibility="Collapsed">
                                <Button x:Name="PlayButton" DockPanel.Dock="Left" MinWidth="96" ToolTip="Play the GIF through the look, at its own speed" />
                                <TextBlock x:Name="FrameCounter" DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center" TextAlignment="Right" FontFamily="Consolas"
                                           AutomationProperties.Name="Frame number" />
                                <Slider x:Name="FrameSlider" Minimum="0" Maximum="1" SmallChange="1" LargeChange="1" IsSnapToTickEnabled="True" TickFrequency="1" IsMoveToPointEnabled="True"
                                        VerticalAlignment="Center" Margin="12,0,0,0" AutomationProperties.Name="Frame" />
                            </DockPanel>

                            <!-- a video's timeline: Play / Pause with its sound, a frame back and on, the time; and the stretch a save takes -->
                            <StackPanel x:Name="VideoBar" Grid.Row="1" Margin="0,10,0,0" Visibility="Collapsed">
                                <DockPanel>
                                    <Button x:Name="VideoPlayButton" DockPanel.Dock="Left" MinWidth="96" />
                                    <Button x:Name="StepBackButton" DockPanel.Dock="Left" Content="◀▮" MinWidth="34" Padding="0" Margin="6,0,0,0" ToolTip="A frame back" AutomationProperties.Name="A frame back" />
                                    <Button x:Name="StepOnButton" DockPanel.Dock="Left" Content="▮▶" MinWidth="34" Padding="0" Margin="4,0,0,0" ToolTip="A frame on" AutomationProperties.Name="A frame on" />
                                    <TextBlock x:Name="VideoTime" DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center" TextAlignment="Right" FontFamily="Consolas" AutomationProperties.Name="Time" />
                                    <Slider x:Name="TimeSlider" Minimum="0" Maximum="1" IsMoveToPointEnabled="True" VerticalAlignment="Center" Margin="12,0,0,0" AutomationProperties.Name="Time in the video" />
                                </DockPanel>
                                <DockPanel Margin="0,6,0,0">
                                    <CheckBox x:Name="VideoSoundBox" DockPanel.Dock="Right" Content="Sound" IsChecked="True" VerticalAlignment="Center" Margin="12,0,0,0"
                                              ToolTip="Its sound while it plays (a save keeps the sound when Export says so)" />
                                    <Button x:Name="SetStartButton" DockPanel.Dock="Left" Content="Start here" ToolTip="What's saved starts at the frame on screen" />
                                    <Button x:Name="SetStopButton" DockPanel.Dock="Left" Content="Stop here" Margin="6,0,0,0" ToolTip="What's saved stops after the frame on screen" />
                                    <Button x:Name="WholeButton" DockPanel.Dock="Left" Content="All of it" Margin="6,0,0,0" ToolTip="Save the whole video" />
                                    <TextBlock x:Name="RangeText" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Dim}" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </StackPanel>

                            <!-- (a fixed height: a readout of two lines never moves the picture) -->
                            <DockPanel x:Name="ViewBar" Grid.Row="2" Margin="0,10,0,0" Height="50">
                                <Border x:Name="DragOut" DockPanel.Dock="Left" Width="40" Height="40" Margin="0,0,12,0" CornerRadius="4" Cursor="Hand"
                                        Background="{DynamicResource Stage}" BorderBrush="{DynamicResource FieldLine}" BorderThickness="1"
                                        ToolTip="Drag the picture into a folder or another program" AutomationProperties.Name="Drag the picture out"
                                        MouseLeftButtonDown="OnDragOutDown" MouseMove="OnDragOutMove">
                                    <Image x:Name="DragThumb" Margin="3" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                </Border>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ToggleButton x:Name="CompareButton" Style="{StaticResource Toggle}" Content="Compare" Command="{x:Static local:Commands.Compare}" Margin="0,0,10,0"
                                                  ToolTip="Show the original left of a divider (drag it)" />
                                    <Button x:Name="FitButton" Content="Fit" MinWidth="0" Command="{x:Static local:Commands.ZoomFit}" ToolTip="See it all (Ctrl+0)" />
                                    <Button x:Name="ZoomOutButton" Content="−" MinWidth="34" Padding="0" Margin="6,0,0,0" Command="{x:Static local:Commands.ZoomOut}" ToolTip="Zoom out (Ctrl+-)" AutomationProperties.Name="Zoom out" />
                                    <TextBlock x:Name="ZoomText" MinWidth="64" TextAlignment="Center" VerticalAlignment="Center" FontFamily="Consolas" />
                                    <Button x:Name="ZoomInButton" Content="+" MinWidth="34" Padding="0" Command="{x:Static local:Commands.ZoomIn}" ToolTip="Zoom in (Ctrl++)" AutomationProperties.Name="Zoom in" />
                                    <Button x:Name="FullScreenButton" Content="Full screen" Margin="10,0,0,0" Command="{x:Static local:Commands.FullScreen}" ToolTip="Just the picture (F11; Esc to come back)" />
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="Readout" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" LineHeight="15" LineStackingStrategy="BlockLineHeight" MaxHeight="30"
                                               FontFamily="Consolas" AutomationProperties.LiveSetting="Polite" />
                                    <TextBlock x:Name="HoldHint" Style="{StaticResource Hint}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                               Text="Hold the picture (or Space) to see the original." />
                                </StackPanel>
                            </DockPanel>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- the ASCII / ANSI studio: the website's sections on the left, the art on the right.
                     Access keys: U for the tab; I M R T L A X for the sections; O, S, C, P (Play) and G
                     (Reset) on buttons, beside F E V H and D, which show on either tab. -->
                <TabItem x:Name="AsciiTab" Header="ASCII / ANSI St_udio">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="370" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
                            <ScrollViewer x:Name="AsciiScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                <StackPanel Margin="20,10,20,20">
                                    <TextBlock Style="{StaticResource Hint}" Margin="0" FontFamily="Courier New"
                                               Text="Your pictures as BBS-style text art. They stay on this PC." />

                                    <Expander x:Name="AsciiImageSection" Style="{StaticResource Section}" Header="_Image" IsExpanded="True">
                                        <StackPanel>
                                            <Button x:Name="AsciiOpenButton" Content="_Open picture or video…" Command="{x:Static local:Commands.OpenPicture}" HorizontalAlignment="Stretch" />
                                            <TextBlock x:Name="AsciiSampleLine" Style="{StaticResource Hint}" Margin="0,8,0,0" />
                                            <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0" TextWrapping="Wrap"
                                                       Text="Or drop a picture or a video on the window, or paste a picture." />
                                            <TextBlock x:Name="AsciiPictureInfo" Margin="0,10,0,0" TextWrapping="Wrap" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Expander>

                                    <Expander x:Name="AsciiModeSection" Style="{StaticResource Section}" Header="_Mode &amp; Columns">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Label}" Margin="0,0,0,4" Text="Style" />
                                            <UniformGrid x:Name="AsciiModeButtons" Columns="2" Margin="0,0,-6,0" />
                                            <StackPanel x:Name="AsciiColumnsPanel">
                                                <TextBlock Style="{StaticResource Label}" Text="Columns" />
                                                <UniformGrid x:Name="AsciiColumnPresets" Columns="2" Margin="0,0,-6,0" />
                                                <DockPanel Margin="0,8,0,0">
                                                    <TextBlock x:Name="AsciiColumnsValue" DockPanel.Dock="Right" />
                                                    <TextBlock Text="Columns width" Foreground="{DynamicResource Dim}" />
                                                </DockPanel>
                                                <Slider x:Name="AsciiColumnsSlider" Minimum="20" Maximum="200" SmallChange="2" LargeChange="10" IsSnapToTickEnabled="True" TickFrequency="2"
                                                        ValueChanged="OnAsciiColumns" AutomationProperties.Name="Columns width" />
                                            </StackPanel>
                                            <TextBlock x:Name="AsciiC64Note" Style="{StaticResource Hint}" Visibility="Collapsed"
                                                       Text="A C64 screen is 40 columns by 25 rows, so PETSCII always fits the picture into that." />
                                            <CheckBox x:Name="AsciiAspectBox" Content="2:1 cell aspect ratio (terminal character compensation)" Margin="0,10,0,0" Checked="OnAsciiAspect" Unchecked="OnAsciiAspect" />
                                        </StackPanel>
                                    </Expander>

                                    <Expander x:Name="AsciiRampSection" Style="{StaticResource Section}" Header="Character _Ramp">
                                        <StackPanel>
                                            <UniformGrid x:Name="AsciiRamps" Columns="3" Margin="0,0,-6,0" />
                                            <TextBlock Style="{StaticResource Label}" Text="Custom ramp" />
                                            <TextBox x:Name="AsciiCustomRamp" FontFamily="Consolas" TextChanged="OnAsciiCustomRamp" AutomationProperties.Name="Custom ramp: the characters, darkest first"
                                                     ToolTip="Enter characters for the ramp, darkest first" />
                                            <CheckBox x:Name="AsciiInvertBox" Content="Invert character density (light on dark)" Margin="0,10,0,0" Checked="OnAsciiInvert" Unchecked="OnAsciiInvert" />
                                        </StackPanel>
                                    </Expander>

                                    <Expander x:Name="AsciiTeletextSection" Style="{StaticResource Section}" Header="_Teletext Options">
                                        <StackPanel>
                                            <CheckBox x:Name="AsciiHeaderBox" Content="Ceefax broadcast header (Page 100)" Checked="OnAsciiTeletext" Unchecked="OnAsciiTeletext" />
                                            <CheckBox x:Name="AsciiSeparatedBox" Content="Separated mosaics (gap mode)" Margin="0,8,0,0" Checked="OnAsciiTeletext" Unchecked="OnAsciiTeletext" />
                                        </StackPanel>
                                    </Expander>

                                    <Expander x:Name="AsciiColourSection" Style="{StaticResource Section}" Header="Colour Profi_le">
                                        <UniformGrid x:Name="AsciiColourModes" Columns="2" Margin="0,0,-6,0" />
                                    </Expander>

                                    <Expander x:Name="AsciiAdjustSection" Style="{StaticResource Section}" Header="_Adjustments">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock x:Name="AsciiContrastValue" DockPanel.Dock="Right" />
                                                <TextBlock Text="Contrast" Foreground="{DynamicResource Dim}" />
                                            </DockPanel>
                                            <Slider x:Name="AsciiContrastSlider" Minimum="-100" Maximum="100" SmallChange="5" LargeChange="10" IsSnapToTickEnabled="True" TickFrequency="5" ValueChanged="OnAsciiAdjust" AutomationProperties.Name="Contrast" />
                                            <DockPanel Margin="0,8,0,0">
                                                <TextBlock x:Name="AsciiBrightnessValue" DockPanel.Dock="Right" />
                                                <TextBlock Text="Brightness" Foreground="{DynamicResource Dim}" />
                                            </DockPanel>
                                            <Slider x:Name="AsciiBrightnessSlider" Minimum="-100" Maximum="100" SmallChange="5" LargeChange="10" IsSnapToTickEnabled="True" TickFrequency="5" ValueChanged="OnAsciiAdjust" AutomationProperties.Name="Brightness" />
                                            <DockPanel Margin="0,8,0,0">
                                                <TextBlock x:Name="AsciiGammaValue" DockPanel.Dock="Right" />
                                                <TextBlock Text="Gamma" Foreground="{DynamicResource Dim}" />
                                            </DockPanel>
                                            <Slider x:Name="AsciiGammaSlider" Minimum="5" Maximum="25" SmallChange="1" LargeChange="2" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnAsciiAdjust" AutomationProperties.Name="Gamma" />
                                        </StackPanel>
                                    </Expander>

                                    <Expander x:Name="AsciiExportSection" Style="{StaticResource Section}" Header="E_xport &amp; Clipboard">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Label}" Margin="0,0,0,4" Text="Copy to the clipboard" />
                                            <UniformGrid Columns="2" Margin="0,0,-6,0">
                                                <Button x:Name="AsciiCopyText" Content="_Copy Text" Click="OnAsciiCopy" Tag="text" Margin="0,0,6,6" />
                                                <Button x:Name="AsciiCopyMarkdown" Content="Copy Markdown" Click="OnAsciiCopy" Tag="markdown" Margin="0,0,6,6" />
                                                <Button x:Name="AsciiCopyAnsi" Content="Copy ANSI Escapes" Click="OnAsciiCopy" Tag="ansi" Margin="0,0,6,6" />
                                                <Button x:Name="AsciiCopyHtml" Content="Copy HTML" Click="OnAsciiCopy" Tag="html" Margin="0,0,6,6" />
                                            </UniformGrid>
                                            <TextBlock Style="{StaticResource Label}" Text="BBS and vintage files" />
                                            <Button x:Name="AsciiSaveAns" Content="Save .ANS (with SAUCE record)…" Click="OnAsciiSaveAns" HorizontalAlignment="Stretch" Margin="0,0,0,6" />
                                            <Button x:Name="AsciiSaveAnsimation" Click="OnAsciiSaveAnsimation" HorizontalAlignment="Stretch" Margin="0,0,0,6" Visibility="Collapsed"
                                                    ToolTip="Every frame drawn over the last, in one .ans (it plays as fast as the viewer sends it)" />
                                            <Button x:Name="AsciiSaveSeq" Content="Save .SEQ (PETSCII stream)…" Click="OnAsciiSaveSeq" HorizontalAlignment="Stretch" Margin="0,0,0,6" />
                                            <Button x:Name="AsciiSavePrg" Content="Save .PRG (runs on a C64)…" Click="OnAsciiSavePrg" HorizontalAlignment="Stretch" Margin="0,0,0,6" />
                                            <Button x:Name="AsciiSaveTxt" Content="Save .TXT (Teletext as text)…" Click="OnAsciiSaveTxt" HorizontalAlignment="Stretch" Margin="0,0,0,6" />
                                            <TextBlock Style="{StaticResource Label}" Text="The picture of it (font graphics)" />
                                            <TextBlock Style="{StaticResource Label}" Margin="0,0,0,4" Text="Size" />
                                            <UniformGrid x:Name="AsciiSizes" Rows="1" Margin="0,0,-6,0" />
                                            <TextBlock x:Name="AsciiSizeLine" Margin="0,8,0,0" TextWrapping="Wrap" FontFamily="Consolas" />
                                            <!-- a video's: the frame rate it goes out at, and its sound -->
                                            <StackPanel x:Name="AsciiVideoRows" Visibility="Collapsed">
                                                <TextBlock Style="{StaticResource Label}" Text="Frame rate" />
                                                <UniformGrid x:Name="AsciiVideoRates" Columns="4" Margin="0,0,-6,0" />
                                                <CheckBox x:Name="AsciiKeepSound" Content="Keep the sound" Margin="0,10,0,0" Checked="OnAsciiKeepSound" Unchecked="OnAsciiKeepSound"
                                                          ToolTip="The MP4 keeps the video's sound, from its start to its stop" />
                                            </StackPanel>
                                            <WrapPanel Margin="0,12,0,0">
                                                <Button x:Name="AsciiSavePng" Content="_Save PNG…" Command="{x:Static local:Commands.SavePng}" Margin="0,0,8,6" />
                                                <Button x:Name="AsciiSaveMp4" Content="Save MP4…" Click="OnAsciiSaveMp4" Margin="0,0,8,6" Visibility="Collapsed" ToolTip="The video's art, frame by frame, from its start to its stop, with its sound" />
                                                <Button x:Name="AsciiSaveGif" Content="Save GIF…" Click="OnAsciiSaveGif" Margin="0,0,8,6" Visibility="Collapsed" ToolTip="Every frame as the art's picture, as a GIF" />
                                                <Button x:Name="AsciiSaveApng" Content="Save APNG…" Click="OnAsciiSaveApng" Margin="0,0,8,6" Visibility="Collapsed" ToolTip="Every frame as the art's picture, as an animated PNG" />
                                                <Button x:Name="AsciiStopButton" Content="Stop" Click="OnStopAnimation" Margin="0,0,0,6" Visibility="Collapsed" AutomationProperties.Name="Stop making it" />
                                            </WrapPanel>
                                            <TextBlock x:Name="AsciiAnimHint" Style="{StaticResource Hint}" Margin="0,2,0,0" Visibility="Collapsed" />
                                        </StackPanel>
                                    </Expander>

                                    <!-- every setting back to how the studio starts (the picture stays) -->
                                    <Button x:Name="AsciiResetButton" Content="Reset settin_gs" Click="OnAsciiResetButton" HorizontalAlignment="Right" Margin="0,18,0,0" MinWidth="150" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- the art -->
                        <Grid x:Name="AsciiStageArea" Grid.Column="1" Margin="24,18,24,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border x:Name="AsciiStage" Background="Black" CornerRadius="8" ClipToBounds="True">
                                <Grid>
                                    <local:PixelView x:Name="AsciiView" AutomationProperties.Name="The art" />
                                    <!-- the website's scanlines over the art: a faint green line every 4 pixels -->
                                    <Rectangle x:Name="AsciiScanlines" IsHitTestVisible="False" Visibility="Collapsed">
                                        <Rectangle.Fill>
                                            <DrawingBrush TileMode="Tile" Viewport="0,0,4,4" ViewportUnits="Absolute" Viewbox="0,0,4,4" ViewboxUnits="Absolute" Stretch="None">
                                                <DrawingBrush.Drawing>
                                                    <DrawingGroup>
                                                        <GeometryDrawing Brush="#00000000" Geometry="M0,0 H4 V2 H0 Z" />
                                                        <GeometryDrawing Brush="#1400FF78" Geometry="M0,2 H4 V4 H0 Z" />
                                                    </DrawingGroup>
                                                </DrawingBrush.Drawing>
                                            </DrawingBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                    <TextBlock x:Name="AsciiStageNote" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                               TextWrapping="Wrap" MaxWidth="420" Margin="20" Foreground="#9D9D9D" FontFamily="Courier New" IsHitTestVisible="False" />
                                </Grid>
                            </Border>

                            <!-- an animated GIF's play bar -->
                            <DockPanel x:Name="AsciiPlayBar" Grid.Row="1" Margin="0,10,0,0" Visibility="Collapsed">
                                <Button x:Name="AsciiPlayButton" DockPanel.Dock="Left" MinWidth="96" />
                                <TextBlock x:Name="AsciiFrameCounter" DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center" TextAlignment="Right" FontFamily="Consolas"
                                           AutomationProperties.Name="Frame number" />
                                <Slider x:Name="AsciiFrameSlider" Minimum="0" Maximum="1" SmallChange="1" LargeChange="1" IsSnapToTickEnabled="True" TickFrequency="1" IsMoveToPointEnabled="True"
                                        VerticalAlignment="Center" Margin="12,0,0,0" AutomationProperties.Name="Frame" />
                            </DockPanel>

                            <!-- a video's timeline -->
                            <StackPanel x:Name="AsciiVideoBar" Grid.Row="1" Margin="0,10,0,0" Visibility="Collapsed">
                                <DockPanel>
                                    <Button x:Name="AsciiVideoPlayButton" DockPanel.Dock="Left" MinWidth="96" />
                                    <Button x:Name="AsciiStepBackButton" DockPanel.Dock="Left" Content="◀▮" MinWidth="34" Padding="0" Margin="6,0,0,0" ToolTip="A frame back" AutomationProperties.Name="A frame back" />
                                    <Button x:Name="AsciiStepOnButton" DockPanel.Dock="Left" Content="▮▶" MinWidth="34" Padding="0" Margin="4,0,0,0" ToolTip="A frame on" AutomationProperties.Name="A frame on" />
                                    <TextBlock x:Name="AsciiVideoTime" DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center" TextAlignment="Right" FontFamily="Consolas" AutomationProperties.Name="Time" />
                                    <Slider x:Name="AsciiTimeSlider" Minimum="0" Maximum="1" IsMoveToPointEnabled="True" VerticalAlignment="Center" Margin="12,0,0,0" AutomationProperties.Name="Time in the video" />
                                </DockPanel>
                                <DockPanel Margin="0,6,0,0">
                                    <CheckBox x:Name="AsciiVideoSoundBox" DockPanel.Dock="Right" Content="Sound" IsChecked="True" VerticalAlignment="Center" Margin="12,0,0,0"
                                              ToolTip="Its sound while it plays (a save keeps the sound when Export says so)" />
                                    <Button x:Name="AsciiSetStartButton" DockPanel.Dock="Left" Content="Start here" ToolTip="What's saved starts at the frame on screen" />
                                    <Button x:Name="AsciiSetStopButton" DockPanel.Dock="Left" Content="Stop here" Margin="6,0,0,0" ToolTip="What's saved stops after the frame on screen" />
                                    <Button x:Name="AsciiWholeButton" DockPanel.Dock="Left" Content="All of it" Margin="6,0,0,0" ToolTip="Save the whole video" />
                                    <TextBlock x:Name="AsciiRangeText" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Dim}" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </StackPanel>

                            <!-- the readout and the view, then the modem (a fixed height: the picture never moves) -->
                            <StackPanel Grid.Row="2" Margin="0,10,0,0" Height="76">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ToggleButton x:Name="AsciiScanlinesButton" Style="{StaticResource Toggle}" Content="Scanlines" Margin="0,0,10,0" Click="OnAsciiScanlines"
                                                      ToolTip="Faint green lines over the art, as on an old monitor (the preview only)" />
                                        <Button Content="Fit" MinWidth="0" Command="{x:Static local:Commands.ZoomFit}" ToolTip="See it all (Ctrl+0)" />
                                        <Button Content="−" MinWidth="34" Padding="0" Margin="6,0,0,0" Command="{x:Static local:Commands.ZoomOut}" ToolTip="Zoom out (Ctrl+-)" AutomationProperties.Name="Zoom out" />
                                        <TextBlock x:Name="AsciiZoomText" MinWidth="64" TextAlignment="Center" VerticalAlignment="Center" FontFamily="Consolas" />
                                        <Button Content="+" MinWidth="34" Padding="0" Command="{x:Static local:Commands.ZoomIn}" ToolTip="Zoom in (Ctrl++)" AutomationProperties.Name="Zoom in" />
                                        <Button Content="Full screen" Margin="10,0,0,0" Command="{x:Static local:Commands.FullScreen}" ToolTip="Just the art (F11; Esc to come back)" />
                                    </StackPanel>
                                    <TextBlock x:Name="AsciiReadout" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontFamily="Consolas" AutomationProperties.LiveSetting="Polite" />
                                </DockPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="Modem:" VerticalAlignment="Center" Foreground="{DynamicResource Dim}" Margin="0,0,6,0" />
                                    <ComboBox x:Name="AsciiBaud" MinWidth="140" SelectionChanged="OnAsciiBaud" AutomationProperties.Name="Modem speed" />
                                    <Button x:Name="AsciiDialButton" Content="Dial up" MinWidth="84" Margin="6,0,0,0" Click="OnAsciiDial" ToolTip="Type the art out at the modem's speed" />
                                    <Button x:Name="AsciiRedialButton" Content="Redial" Margin="6,0,0,0" Click="OnAsciiRedial" ToolTip="Type it out again from the start" />
                                    <TextBlock x:Name="AsciiBaudProgress" Margin="10,0,0,0" VerticalAlignment="Center" FontFamily="Consolas" Foreground="{DynamicResource Dim}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- the EXIF Scrubber: the website's sections on the left, the inspector on the right.
                     Access keys: B for the tab; I T C for the sections; O L S Z R A M N P on its
                     controls, beside F E V H and D U J, which show on every tab. -->
                <TabItem x:Name="ScrubTab" Header="EXIF Scru_bber">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="370" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
                            <ScrollViewer x:Name="ScrubScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                <StackPanel Margin="20,10,20,20">
                                    <TextBlock Style="{StaticResource Hint}" Margin="0" FontFamily="Courier New" TextWrapping="Wrap"
                                               Text="What your photos and videos say about you, and taking it out. They stay on this PC." />

                                    <Expander x:Name="ScrubImageSection" Style="{StaticResource Section}" Header="_Image &amp; Batch" IsExpanded="True">
                                        <StackPanel>
                                            <Button x:Name="ScrubOpenButton" Content="_Open picture or video…" Command="{x:Static local:Commands.OpenPicture}" HorizontalAlignment="Stretch" />
                                            <UniformGrid Rows="1" Margin="0,8,0,0">
                                                <Button x:Name="ScrubAddButton" Content="Add to the batch…" Click="OnExifAddFiles" Margin="0,0,4,0"
                                                        ToolTip="Pictures or videos to clean together (Ctrl+click picks several)" />
                                                <Button x:Name="ScrubFolderAddButton" Content="Add a fo_lder…" Click="OnExifAddFolder" Margin="4,0,0,0"
                                                        ToolTip="A folder's own pictures and videos into the batch (Ctrl+B)" />
                                            </UniformGrid>
                                            <TextBlock x:Name="ScrubSampleLine" Style="{StaticResource Hint}" Margin="0,8,0,0" />
                                            <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0" TextWrapping="Wrap"
                                                       Text="Or drop a photo or video on the window, or paste one. Drop several, or folders, for a batch." />
                                            <TextBlock x:Name="ScrubPictureInfo" Margin="0,10,0,0" TextWrapping="Wrap" FontWeight="SemiBold" />
                                            <Button x:Name="ScrubClearBatchButton" Content="Cle_ar batch" Click="OnExifClearBatch" HorizontalAlignment="Left" Margin="0,8,0,0" Visibility="Collapsed" />
                                        </StackPanel>
                                    </Expander>

                                    <Expander x:Name="ScrubOptionsSection" Style="{StaticResource Section}" Header="Scrubbing Op_tions">
                                        <StackPanel>
                                            <RadioButton x:Name="ScrubAllButton" GroupName="ScrubMode" Checked="OnScrubMode">
                                                <StackPanel>
                                                    <AccessText FontWeight="SemiBold" Text="Re_move all metadata (Recommended)" />
                                                    <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0" TextWrapping="Wrap"
                                                               Text="Strips camera, lens, GPS, timestamps, comments, thumbnails, and trailers. Retains orientation and colour profile. A video keeps its picture and sound, byte for byte." />
                                                </StackPanel>
                                            </RadioButton>
                                            <RadioButton x:Name="ScrubLocationButton" GroupName="ScrubMode" Checked="OnScrubMode" Margin="0,10,0,0">
                                                <StackPanel>
                                                    <AccessText FontWeight="SemiBold" Text="Remove location o_nly" />
                                                    <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0" TextWrapping="Wrap"
                                                               Text="Wipes GPS coordinates and trailers, but keeps camera model, lens, exposure settings, and date." />
                                                </StackPanel>
                                            </RadioButton>
                                            <CheckBox x:Name="ScrubOrientationBox" Margin="0,14,0,0" Checked="OnScrubOrientation" Unchecked="OnScrubOrientation">
                                                <StackPanel>
                                                    <AccessText FontWeight="SemiBold" Text="_Preserve orientation tag" />
                                                    <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0" TextWrapping="Wrap" Text="Ensures vertical phone photos render upright in image viewers." />
                                                </StackPanel>
                                            </CheckBox>
                                        </StackPanel>
                                    </Expander>

                                    <Expander x:Name="ScrubSaveSection" Style="{StaticResource Section}" Header="_Clean &amp; Save" IsExpanded="True">
                                        <StackPanel>
                                            <Button x:Name="ScrubSaveButton" Content="_Scrub &amp; save a clean copy…" Click="OnScrubSave" HorizontalAlignment="Stretch"
                                                    ToolTip="A copy with the metadata out, beside the original or where you pick (Ctrl+S); the original stays as it is" />
                                            <Button x:Name="ScrubZipButton" Content="Clean the batch into a _ZIP…" Click="OnScrubZip" HorizontalAlignment="Stretch" Visibility="Collapsed" />
                                            <Button x:Name="ScrubIntoButton" Content="Clean the batch into a folde_r…" Click="OnScrubInto" HorizontalAlignment="Stretch" Margin="0,8,0,0" Visibility="Collapsed"
                                                    ToolTip="Each file's clean copy into a folder you pick, named photo-clean.jpg; nothing there is written over" />
                                            <Button x:Name="ScrubStopButton" Content="Stop" Click="OnExifStop" HorizontalAlignment="Left" Margin="0,8,0,0" Visibility="Collapsed" AutomationProperties.Name="Stop cleaning" />
                                            <TextBlock x:Name="ScrubStatus" Margin="0,10,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                        <Border x:Name="ScrubStageSlot" Grid.Column="1" Margin="24,18,14,12" />
                    </Grid>
                </TabItem>

                <!-- the EXIF Injector: the form on the left, the same inspector on the right. Access keys: J for
                     the tab; P C L T G I for the sections; O R 0 A N Q K S on its buttons. -->
                <TabItem x:Name="InjectTab" Header="EXIF In_jector">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="370" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
                            <ScrollViewer x:Name="InjectScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                <StackPanel Margin="20,10,20,20">
                                    <TextBlock Style="{StaticResource Hint}" Margin="0" FontFamily="Courier New" TextWrapping="Wrap"
                                               Text="Write your own camera, date and place into a photo. The pixels stay as they are." />

                                    <Expander x:Name="InjectPhotoSection" Style="{StaticResource Section}" Header="_Photo" IsExpanded="True">
                                        <StackPanel>
                                            <Button x:Name="InjectOpenButton" Content="_Open picture or video…" Command="{x:Static local:Commands.OpenPicture}" HorizontalAlignment="Stretch" />
                                            <TextBlock x:Name="InjectSampleLine" Style="{StaticResource Hint}" Margin="0,8,0,0" />
                                            <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0" TextWrapping="Wrap" Text="Or drop a photo on the window, or paste one." />
                                            <TextBlock x:Name="InjectPictureInfo" Margin="0,10,0,0" TextWrapping="Wrap" FontWeight="SemiBold" />
                                            <TextBlock x:Name="InjectFormatNote" Style="{StaticResource Hint}" Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                                        </StackPanel>
                                    </Expander>

                                    <Expander x:Name="InjectCameraSection" Style="{StaticResource Section}" Header="_Camera &amp; Creator">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Hint}" Margin="0" TextWrapping="Wrap" Text="The fields start with what the photo has. Change any of them, or empty one to remove it." />
                                            <TextBlock Style="{StaticResource Label}" Text="Device preset" />
                                            <ComboBox x:Name="InjectPreset" SelectionChanged="OnInjectPreset" AutomationProperties.Name="Device preset" />
                                            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" TextWrapping="Wrap"
                                                       Text="A preset fills in the camera, lens and exposure the way that device writes them; injecting then also drops the old camera's serial numbers and maker data. The date, place and creator stay as they are." />
                                            <WrapPanel Margin="0,10,0,0">
                                                <Button x:Name="InjectResetButton" Content="_Reset to photo" Click="OnInjectReset" Margin="0,0,6,6" ToolTip="Put back what the photo has" />
                                                <Button x:Name="InjectDefaultsButton" Content="b_0r3d Defaults" Click="OnInjectDefaults" Margin="0,0,6,6" />
                                                <Button x:Name="InjectClearButton" Content="Cle_ar fields" Click="OnInjectClear" Margin="0,0,0,6" ToolTip="Empty every field (injecting then removes those tags)" />
                                            </WrapPanel>
                                            <UniformGrid Columns="2" Margin="0,4,-8,0">
                                                <StackPanel Margin="0,0,8,0"><TextBlock Style="{StaticResource Label}" Text="Camera Make" /><TextBox x:Name="InjectMake" Style="{StaticResource Placeheld}" AutomationProperties.Name="Camera Make" Tag="e.g. Nikon, Apple, b0r3d optics" /></StackPanel>
                                                <StackPanel Margin="0,0,8,0"><TextBlock Style="{StaticResource Label}" Text="Camera Model" /><TextBox x:Name="InjectModel" Style="{StaticResource Placeheld}" AutomationProperties.Name="Camera Model" Tag="e.g. Z8, iPhone 15 Pro, Ruckus-Cam" /></StackPanel>
                                                <StackPanel Margin="0,0,8,0"><TextBlock Style="{StaticResource Label}" Text="Artist / Creator" /><TextBox x:Name="InjectArtist" Style="{StaticResource Placeheld}" AutomationProperties.Name="Artist / Creator" Tag="e.g. still_b0r3d" /></StackPanel>
                                                <StackPanel Margin="0,0,8,0"><TextBlock Style="{StaticResource Label}" Text="Copyright" /><TextBox x:Name="InjectCopyright" Style="{StaticResource Placeheld}" AutomationProperties.Name="Copyright" Tag="e.g. (c) 2026 b0r3d.org" /></StackPanel>
                                                <StackPanel Margin="0,0,8,0"><TextBlock Style="{StaticResource Label}" Text="Software" /><TextBox x:Name="InjectSoftware" Style="{StaticResource Placeheld}" AutomationProperties.Name="Software" Tag="e.g. b0r3d DeRes" /></StackPanel>
                                                <StackPanel Margin="0,0,8,0"><TextBlock Style="{StaticResource Label}" Text="Orientation" /><ComboBox x:Name="InjectOrientation" AutomationProperties.Name="Orientation" /></StackPanel>
                                            </UniformGrid>
                                        </StackPanel>
                                    </Expander>

                                    <Expander x:Name="InjectLensSection" Style="{StaticResource Section}" Header="_Lens &amp; Exposure">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Label}" Margin="0,0,0,4" Text="Lens Model" />
                                            <TextBox x:Name="InjectLens" Style="{StaticResource Placeheld}" AutomationProperties.Name="Lens Model" Tag="e.g. b0r3d Prime 28mm f/1.4 Deluxe" />
                                            <UniformGrid Columns="2" Margin="0,0,-8,0">
                                                <StackPanel Margin="0,0,8,0"><TextBlock Style="{StaticResource Label}" Text="Aperture (f-stop)" /><TextBox x:Name="InjectAperture" Style="{StaticResource Placeheld}" AutomationProperties.Name="Aperture (f-stop)" Tag="e.g. 1.4, 2.8" /></StackPanel>
                                                <StackPanel Margin="0,0,8,0"><TextBlock Style="{StaticResource Label}" Text="Shutter Speed" /><TextBox x:Name="InjectShutter" Style="{StaticResource Placeheld}" AutomationProperties.Name="Shutter Speed" Tag="e.g. 1/250, 0.5, 2" /></StackPanel>
                                                <StackPanel Margin="0,0,8,0"><TextBlock Style="{StaticResource Label}" Text="ISO" /><TextBox x:Name="InjectIso" Style="{StaticResource Placeheld}" AutomationProperties.Name="ISO" Tag="e.g. 100, 400" /></StackPanel>
                                                <StackPanel Margin="0,0,8,0"><TextBlock Style="{StaticResource Label}" Text="Focal Length (mm)" /><TextBox x:Name="InjectFocal" Style="{StaticResource Placeheld}" AutomationProperties.Name="Focal Length (mm)" Tag="e.g. 28, 4.25" /></StackPanel>
                                            </UniformGrid>
                                        </StackPanel>
                                    </Expander>

                                    <Expander x:Name="InjectTimeSection" Style="{StaticResource Section}" Header="_Timestamp &amp; Caption">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Label}" Margin="0,0,0,4" Text="Date &amp; Time" />
                                            <DockPanel>
                                                <Button x:Name="InjectNowButton" DockPanel.Dock="Right" Content="_Now" Margin="6,0,0,0" Click="OnInjectNow" ToolTip="Fill in the time now" />
                                                <TextBox x:Name="InjectDateTime" Style="{StaticResource Placeheld}" AutomationProperties.Name="Date &amp; Time" Tag="YYYY:MM:DD HH:MM:SS" />
                                            </DockPanel>
                                            <TextBlock Style="{StaticResource Label}" Text="Description / Title" />
                                            <TextBox x:Name="InjectDescription" Style="{StaticResource Placeheld}" AutomationProperties.Name="Description / Title" Tag="Photo title or description" />
                                        </StackPanel>
                                    </Expander>

                                    <Expander x:Name="InjectGpsSection" Style="{StaticResource Section}" Header="_GPS Location">
                                        <StackPanel>
                                            <UniformGrid Columns="3" Margin="0,0,-8,0">
                                                <StackPanel Margin="0,0,8,0"><TextBlock Style="{StaticResource Label}" Margin="0,0,0,4" Text="GPS Latitude" /><TextBox x:Name="InjectLat" Style="{StaticResource Placeheld}" AutomationProperties.Name="GPS Latitude" Tag="e.g. 41.8781" /></StackPanel>
                                                <StackPanel Margin="0,0,8,0"><TextBlock Style="{StaticResource Label}" Margin="0,0,0,4" Text="GPS Longitude" /><TextBox x:Name="InjectLon" Style="{StaticResource Placeheld}" AutomationProperties.Name="GPS Longitude" Tag="e.g. -87.6298" /></StackPanel>
                                                <StackPanel Margin="0,0,8,0"><TextBlock Style="{StaticResource Label}" Margin="0,0,0,4" Text="Altitude (m)" /><TextBox x:Name="InjectAlt" Style="{StaticResource Placeheld}" AutomationProperties.Name="Altitude (m)" Tag="e.g. 182" /></StackPanel>
                                            </UniformGrid>
                                            <WrapPanel Margin="0,10,0,0">
                                                <Button Content="📍 Chicago H_Q" Click="OnInjectPlace" Tag="41.878113 -87.629799 182" Margin="0,0,6,6" ToolTip="Downtown Chicago, Illinois" />
                                                <Button Content="📍 A_kihabara" Click="OnInjectPlace" Tag="35.6983 139.773 10" Margin="0,0,6,6" ToolTip="Akihabara Electric Town, Tokyo" />
                                                <Button Content="📍 Null Island" Click="OnInjectPlace" Tag="0 0 0" Margin="0,0,6,6" ToolTip="0°N 0°E (Null Island)" />
                                                <Button Content="Clear GPS" Click="OnInjectPlace" Tag="" Margin="0,0,0,6" />
                                            </WrapPanel>
                                            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" TextWrapping="Wrap" Text="A new location replaces all of the photo's GPS tags." />
                                        </StackPanel>
                                    </Expander>

                                    <Expander x:Name="InjectSaveSection" Style="{StaticResource Section}" Header="_Inject &amp; Save" IsExpanded="True">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Hint}" Margin="0" TextWrapping="Wrap"
                                                       Text="Only the fields you change are written; the rest of the photo's EXIF stays as it was. The pixels aren't touched." />
                                            <CheckBox x:Name="InjectXmpBox" Margin="0,10,0,0" Visibility="Collapsed">
                                                <StackPanel>
                                                    <TextBlock FontWeight="SemiBold" Text="Remove the XMP block too" />
                                                    <TextBlock x:Name="InjectXmpText" Style="{StaticResource Hint}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </CheckBox>
                                            <Button x:Name="InjectSaveButton" Content="Inject EXIF &amp; _save…" Click="OnInjectSave" HorizontalAlignment="Stretch" Margin="0,12,0,0"
                                                    ToolTip="A new copy with your changes (Ctrl+S); the original stays as it is" />
                                            <TextBlock x:Name="InjectStatus" Margin="0,10,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                        <Border x:Name="InjectStageSlot" Grid.Column="1" Margin="24,18,14,12" />
                    </Grid>
                </TabItem>
            </TabControl>

            <!-- the name, on the tab strip -->
            <StackPanel x:Name="Brand" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18,4,0,0" IsHitTestVisible="False">
                <Image x:Name="CupPicture" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                <TextBlock Text="b0r3d DeRes" FontFamily="Courier New" FontWeight="Bold" FontSize="20" Margin="9,0,0,0" VerticalAlignment="Center" Effect="{DynamicResource TitleGlow}" />
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
