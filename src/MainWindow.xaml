<Window x:Class="B0r3dDeRes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:B0r3dDeRes"
        Title="b0r3d DeRes" Width="1280" Height="800" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Icon="/b0r3dDeRes;component/assets/b0r3dDeRes.ico"
        Background="{DynamicResource Back}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        AllowDrop="True" PreviewDragEnter="OnPreviewDragOver" PreviewDragOver="OnPreviewDragOver" PreviewDrop="OnPreviewDrop"
        DragEnter="OnDragElsewhere" DragOver="OnDragElsewhere" Drop="OnDragElsewhere"
        PreviewKeyDown="OnPreviewKeys" PreviewKeyUp="OnPreviewKeysUp" KeyDown="OnKeys">

    <Window.CommandBindings>
        <CommandBinding Command="{x:Static local:Commands.OpenPicture}" Executed="OnOpenPicture" />
        <CommandBinding Command="{x:Static local:Commands.DeresScreen}" Executed="OnDeresScreen" CanExecute="WhenNotSnipping" />
        <CommandBinding Command="{x:Static local:Commands.Batch}" Executed="OnBatch" />
        <CommandBinding Command="{x:Static local:Commands.PastePicture}" Executed="OnPastePicture" />
        <CommandBinding Command="{x:Static local:Commands.SavePng}" Executed="OnSavePng" CanExecute="WhenThereIsAPicture" />
        <CommandBinding Command="{x:Static local:Commands.CopyPicture}" Executed="OnCopyPicture" CanExecute="WhenThereIsAPicture" />
        <CommandBinding Command="{x:Static local:Commands.ZoomIn}" Executed="OnZoomIn" CanExecute="WhenThereIsAPicture" />
        <CommandBinding Command="{x:Static local:Commands.ZoomOut}" Executed="OnZoomOut" CanExecute="WhenThereIsAPicture" />
        <CommandBinding Command="{x:Static local:Commands.ZoomFit}" Executed="OnZoomFit" CanExecute="WhenThereIsAPicture" />
        <CommandBinding Command="{x:Static local:Commands.ZoomOne}" Executed="OnZoomOne" CanExecute="WhenThereIsAPicture" />
        <CommandBinding Command="{x:Static local:Commands.Compare}" Executed="OnCompare" CanExecute="WhenThereIsAnOriginal" />
        <CommandBinding Command="{x:Static local:Commands.FullScreen}" Executed="OnFullScreen" CanExecute="WhenThereIsAPicture" />
        <CommandBinding Command="{x:Static local:Commands.About}" Executed="OnAbout" />
    </Window.CommandBindings>

    <DockPanel x:Name="Root" Background="{DynamicResource Back}">
        <!-- Access keys: F E V H on the bar, D for the tab; I W A T G N X for the sections; O, S, C,
             B, L, U, K, R and P (Play) on buttons; each menu list has its own. -->
        <Menu x:Name="MenuBar" DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Open picture or video…" Command="{x:Static local:Commands.OpenPicture}" />
                <MenuItem x:Name="SamplesMenu" Header="Open a sa_mple" />
                <MenuItem Header="DeRes the scree_n…" Command="{x:Static local:Commands.DeresScreen}" />
                <MenuItem Header="_Batch: a folder or several pictures…" Command="{x:Static local:Commands.Batch}" />
                <MenuItem Header="Open _look…" Click="OnOpenLook" />
                <MenuItem Header="Open p_alette…" Click="OnLoadPalette" />
                <Separator />
                <MenuItem Header="_Save PNG…" Command="{x:Static local:Commands.SavePng}" />
                <MenuItem x:Name="SaveGifMenu" Header="Save _GIF…" Click="OnSaveGif" />
                <MenuItem x:Name="SaveApngMenu" Header="Save A_PNG…" Click="OnSaveApng" />
                <MenuItem x:Name="SaveMp4Menu" Header="Save MP_4…" Click="OnSaveMp4" />
                <MenuItem x:Name="SaveFramesMenu" Header="Save PNG f_rames…" Click="OnSaveFrames" />
                <MenuItem x:Name="WallpaperMenu" Header="Save _wallpaper" />
                <MenuItem x:Name="EmulatorMenu" Header="Save for an _emulator…" Click="OnSaveEmulator" />
                <MenuItem Header="Save loo_k…" Click="OnSaveLook" />
                <MenuItem x:Name="SavePaletteMenu" Header="Save pale_tte…" Click="OnSavePalette" />
                <Separator />
                <MenuItem Header="E_xit" InputGestureText="Alt+F4" Click="OnExit" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Copy picture" Command="{x:Static local:Commands.CopyPicture}" InputGestureText="Ctrl+C" />
                <MenuItem Header="_Paste picture or link" Command="{x:Static local:Commands.PastePicture}" InputGestureText="Ctrl+V" />
                <Separator />
                <MenuItem Header="Copy share _link" Click="OnCopyLink" />
                <MenuItem x:Name="GrabMenu" Header="_Grab palette" Click="OnGrabPalette" />
                <MenuItem Header="S_urprise me" Click="OnSurprise" />
                <Separator />
                <MenuItem Header="_Reset settings…" Click="OnResetMenu" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="Zoom _in" Command="{x:Static local:Commands.ZoomIn}" InputGestureText="Ctrl++" />
                <MenuItem Header="Zoom _out" Command="{x:Static local:Commands.ZoomOut}" InputGestureText="Ctrl+-" />
                <MenuItem Header="_Fit" Command="{x:Static local:Commands.ZoomFit}" />
                <MenuItem Header="_1 screen pixel a pixel" Command="{x:Static local:Commands.ZoomOne}" />
                <Separator />
                <MenuItem x:Name="CompareMenu" Header="_Compare" Command="{x:Static local:Commands.Compare}" IsCheckable="False" />
                <MenuItem x:Name="FullScreenMenu" Header="F_ull screen" Command="{x:Static local:Commands.FullScreen}" />
                <MenuItem x:Name="PlayMenu" Header="_Play or pause" Click="OnPlayMenu" />
                <Separator />
                <MenuItem Header="_Look">
                    <MenuItem x:Name="LookWindows" Header="Like _Windows" IsCheckable="True" Tag="Windows" Click="OnLook" />
                    <MenuItem x:Name="LookLight" Header="_Light" IsCheckable="True" Tag="Light" Click="OnLook" />
                    <MenuItem x:Name="LookDark" Header="_Dark" IsCheckable="True" Tag="Dark" Click="OnLook" />
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About b0r3d DeRes" Command="{x:Static local:Commands.About}" />
                <Separator />
                <MenuItem Header="_img.b0r3d.org, the website" Click="OnWebsite" />
                <MenuItem Header="b0r3d._org" Click="OnMaker" />
            </MenuItem>
        </Menu>

        <!-- the bottom line: notes on the left, the version on the right -->
        <Border x:Name="BottomLine" DockPanel.Dock="Bottom" Background="{DynamicResource MenuBar}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="14,5">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource Dim}" Margin="16,0,0,0">
                    <Run x:Name="VersionRun" /><Run Text=" · " /><Hyperlink Click="OnMaker">b0r3d.org</Hyperlink>
                </TextBlock>
                <TextBlock x:Name="Note" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <Grid>
            <TabControl x:Name="Tabs" Padding="236,4,14,0">
                <TabItem x:Name="DeresTab" Header="_DeRes">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="PanelColumn" Width="370" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- the settings, in fold-out sections like the website's -->
                        <Border x:Name="Panel" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
                            <ScrollViewer x:Name="PanelScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                <StackPanel Margin="20,10,20,20">
                                    <TextBlock Style="{StaticResource Hint}" Margin="0" FontFamily="Courier New"
                                               Text="Retro looks for your pictures. They stay on this PC." />

                                    <Expander x:Name="ImageSection" Style="{StaticResource Section}" Header="_Image" IsExpanded="True">
                                        <StackPanel>
                                            <Button x:Name="OpenButton" Content="_Open picture or video…" Command="{x:Static local:Commands.OpenPicture}" HorizontalAlignment="Stretch" />
                                            <UniformGrid Rows="1" Margin="0,8,0,0">
                                                <Button x:Name="SnipButton" Content="DeRes the screen…" Command="{x:Static local:Commands.DeresScreen}" Margin="0,0,4,0"
                                                        ToolTip="A box of the screen, a whole screen or all of them becomes the picture (Ctrl+Shift+D)" />
                                                <Button x:Name="BatchButton" Content="Batch…" Command="{x:Static local:Commands.Batch}" Margin="4,0,0,0"
                                                        ToolTip="A folder or several pictures through this look into a folder (Ctrl+B)" />
                                            </UniformGrid>
                                            <TextBlock x:Name="SampleLine" Style="{StaticResource Hint}" Margin="0,8,0,0" />
                                            <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0" TextWrapping="Wrap"
                                                       Text="Or drop a picture or a video on the window, or paste a picture. Drop a folder, or several pictures or videos, for a batch." />
                                            <TextBlock x:Name="PictureInfo" Margin="0,10,0,0" TextWrapping="Wrap" FontWeight="SemiBold" />

                                            <TextBlock Style="{StaticResource Label}" Text="Resolution" />
                                            <UniformGrid Rows="1">
                                                <RadioButton x:Name="NativeButton" Style="{StaticResource Segment}" GroupName="Resolution" Content="Native" Checked="OnResolution" AutomationProperties.Name="Native resolution" />
                                                <RadioButton x:Name="CustomButton" Style="{StaticResource Segment}" GroupName="Resolution" Content="Custom size" Margin="0" Checked="OnResolution" AutomationProperties.Name="Custom size" />
                                            </UniformGrid>
                                            <StackPanel x:Name="WidthPanel" Visibility="Collapsed" Margin="0,10,0,0">
                                                <DockPanel>
                                                    <TextBlock Text="Width" Width="52" VerticalAlignment="Center" Foreground="{DynamicResource Dim}" />
                                                    <TextBox x:Name="WidthBox" Width="70" TextChanged="OnWidthTyped" LostKeyboardFocus="OnWidthLeft" KeyDown="OnWidthKey" AutomationProperties.Name="Custom width in pixels" />
                                                    <TextBlock x:Name="WidthHeight" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Dim}" />
                                                </DockPanel>
                                                <Slider x:Name="WidthSlider" Minimum="0" Maximum="1000" SmallChange="1" LargeChange="50" Margin="0,6,0,0" ValueChanged="OnWidthSlider" AutomationProperties.Name="Width" />
                                            </StackPanel>
                                            <TextBlock x:Name="ResolutionInfo" Style="{StaticResource Hint}" />

                                            <StackPanel x:Name="FitPanel">
                                                <TextBlock Style="{StaticResource Label}" Text="Framing" />
                                                <UniformGrid Rows="1">
                                                    <RadioButton x:Name="FitFill" Style="{StaticResource Segment}" GroupName="Framing" Content="Crop to fill" Tag="fill" Padding="0" Checked="OnFraming" AutomationProperties.Name="Crop to fill" />
                                                    <RadioButton x:Name="FitFit" Style="{StaticResource Segment}" GroupName="Framing" Content="Fit, with bars" Tag="fit" Padding="0" Checked="OnFraming" AutomationProperties.Name="Fit, with bars" />
                                                    <RadioButton x:Name="FitStretch" Style="{StaticResource Segment}" GroupName="Framing" Content="Stretch" Tag="stretch" Margin="0" Checked="OnFraming" AutomationProperties.Name="Stretch" />
                                                </UniformGrid>
                                            </StackPanel>

                                            <DockPanel Margin="0,12,0,0">
                                                <TextBlock x:Name="DetailValue" DockPanel.Dock="Right" />
                                                <TextBlock Text="Detail" Foreground="{DynamicResource Dim}" />
                                            </DockPanel>
                                            <Slider x:Name="DetailSlider" Minimum="0" Maximum="20" SmallChange="1" LargeChange="2" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnDetail" AutomationProperties.Name="Detail" />
                                            <TextBlock x:Name="DetailHint" Style="{StaticResource Hint}" />

                                            <StackPanel x:Name="BackgroundPanel" Visibility="Collapsed">
                                                <TextBlock Style="{StaticResource Label}" Text="Transparent areas" />
                                                <UniformGrid Rows="1">
                                                    <RadioButton x:Name="BackWhite" Style="{StaticResource Segment}" GroupName="Background" Content="White" Tag="white" Checked="OnBackground" AutomationProperties.Name="Transparent areas on white" />
                                                    <RadioButton x:Name="BackBlack" Style="{StaticResource Segment}" GroupName="Background" Content="Black" Tag="black" Checked="OnBackground" AutomationProperties.Name="Transparent areas on black" />
                                                    <RadioButton x:Name="BackKeep" Style="{StaticResource Segment}" GroupName="Background" Content="Keep" Tag="transparent" Margin="0" Checked="OnBackground" AutomationProperties.Name="Keep transparent areas see-through" />
                                                </UniformGrid>
                                                <TextBlock x:Name="KeepNote" Style="{StaticResource Hint}" Visibility="Collapsed" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Expander>

                                    <Expander x:Name="HardwareSection" Style="{StaticResource Section}" Header="Hard_ware">
                                        <StackPanel>
                                            <Button x:Name="SurpriseButton" Content="S_urprise me" Click="OnSurprise" HorizontalAlignment="Stretch" Margin="0,0,0,10"
                                                    ToolTip="A random machine, dither and adjustments" />
                                            <UniformGrid x:Name="Cards" Columns="2" Margin="0,0,-6,0" />
                                            <TextBlock x:Name="AboutLine" Style="{StaticResource Hint}" Margin="0,4,0,0" />
                                            <!-- the tile meter: would it fit the machine? -->
                                            <Border x:Name="TileFit" Visibility="Collapsed" Margin="0,8,0,0" Padding="10,6" CornerRadius="4" BorderThickness="1" Background="{DynamicResource Field}">
                                                <TextBlock x:Name="TileFitText" FontFamily="Consolas" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                                            </Border>
                                            <!-- the machines that pick their colours from the picture -->
                                            <StackPanel x:Name="PaletteTools" Visibility="Collapsed" Margin="0,12,0,0">
                                                <StackPanel x:Name="ColoursPanel">
                                                    <DockPanel>
                                                        <TextBlock x:Name="ColoursValue" DockPanel.Dock="Right" />
                                                        <TextBlock Text="Colours" Foreground="{DynamicResource Dim}" />
                                                    </DockPanel>
                                                    <Slider x:Name="ColoursSlider" Minimum="2" Maximum="256" SmallChange="1" LargeChange="8" IsSnapToTickEnabled="True" TickFrequency="1"
                                                            ValueChanged="OnColours" AutomationProperties.Name="Colours" />
                                                </StackPanel>
                                                <WrapPanel Margin="0,8,0,0">
                                                    <Button x:Name="LoadPaletteButton" Content="_Load palette…" Click="OnLoadPalette" Margin="0,0,8,6" ToolTip=".hex, .pal, .gpl or a palette .png" />
                                                    <Button x:Name="GrabPaletteButton" Content="Gra_b palette" Click="OnGrabPalette" Margin="0,0,0,6" ToolTip="Pick the colours from the picture" />
                                                </WrapPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </Expander>

                                    <Expander x:Name="AdjustSection" Style="{StaticResource Section}" Header="_Adjust">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock x:Name="BrightnessValue" DockPanel.Dock="Right" />
                                                <TextBlock Text="Brightness" Foreground="{DynamicResource Dim}" />
                                            </DockPanel>
                                            <Slider x:Name="BrightnessSlider" Minimum="-50" Maximum="50" SmallChange="1" LargeChange="10" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnAdjust" AutomationProperties.Name="Brightness" />
                                            <DockPanel Margin="0,8,0,0">
                                                <TextBlock x:Name="ContrastValue" DockPanel.Dock="Right" />
                                                <TextBlock Text="Contrast" Foreground="{DynamicResource Dim}" />
                                            </DockPanel>
                                            <Slider x:Name="ContrastSlider" Minimum="0" Maximum="200" SmallChange="1" LargeChange="10" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnAdjust" AutomationProperties.Name="Contrast" />
                                            <DockPanel Margin="0,8,0,0">
                                                <TextBlock x:Name="SaturationValue" DockPanel.Dock="Right" />
                                                <TextBlock Text="Saturation" Foreground="{DynamicResource Dim}" />
                                            </DockPanel>
                                            <Slider x:Name="SaturationSlider" Minimum="0" Maximum="200" SmallChange="1" LargeChange="10" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnAdjust" AutomationProperties.Name="Saturation" />
                                            <DockPanel Margin="0,8,0,0">
                                                <TextBlock x:Name="GammaValue" DockPanel.Dock="Right" />
                                                <TextBlock Text="Gamma" Foreground="{DynamicResource Dim}" />
                                            </DockPanel>
                                            <Slider x:Name="GammaSlider" Minimum="40" Maximum="250" SmallChange="1" LargeChange="10" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnAdjust" AutomationProperties.Name="Gamma" />
                                            <Button x:Name="AdjustReset" Content="Reset" Click="OnAdjustReset" HorizontalAlignment="Left" Margin="0,12,0,0" AutomationProperties.Name="Reset the adjustments" />
                                        </StackPanel>
                                    </Expander>

                                    <Expander x:Name="DitherSection" Style="{StaticResource Section}" Header="Di_ther">
                                        <StackPanel>
                                            <TextBlock x:Name="DitherNote" Style="{StaticResource Hint}" Margin="0,0,0,8" Visibility="Collapsed" />
                                            <StackPanel x:Name="Dithers" />
                                        </StackPanel>
                                    </Expander>

                                    <Expander x:Name="SignalSection" Style="{StaticResource Section}" Header="Si_gnal">
                                        <StackPanel>
                                            <!-- the buttons, in two rows of four columns: Machine's own takes two -->
                                            <Grid x:Name="SignalButtons" Margin="0,0,-6,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition />
                                                    <ColumnDefinition />
                                                    <ColumnDefinition />
                                                    <ColumnDefinition />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                            </Grid>
                                            <TextBlock x:Name="SignalNote" Style="{StaticResource Hint}" Margin="0,2,0,0" />
                                            <!-- while it's on -->
                                            <StackPanel x:Name="SignalPanel">
                                                <DockPanel Margin="0,12,0,0">
                                                    <TextBlock x:Name="WearValue" DockPanel.Dock="Right" />
                                                    <TextBlock Text="Wear" Foreground="{DynamicResource Dim}" />
                                                </DockPanel>
                                                <Slider x:Name="WearSlider" Minimum="0" Maximum="100" SmallChange="5" LargeChange="10" IsSnapToTickEnabled="True" TickFrequency="5" ValueChanged="OnSignalSlider" AutomationProperties.Name="Wear" />
                                                <Expander x:Name="SignalAdvanced" Style="{StaticResource SubSection}" Header="Advanced" Margin="0,10,0,0">
                                                    <StackPanel>
                                                        <DockPanel>
                                                            <TextBlock x:Name="SignalColourValue" DockPanel.Dock="Right" />
                                                            <TextBlock Text="Colour" Foreground="{DynamicResource Dim}" />
                                                        </DockPanel>
                                                        <Slider x:Name="SignalColourSlider" Minimum="0" Maximum="150" SmallChange="5" LargeChange="10" IsSnapToTickEnabled="True" TickFrequency="5" ValueChanged="OnSignalSlider" AutomationProperties.Name="Signal colour" />
                                                        <DockPanel Margin="0,8,0,0">
                                                            <TextBlock x:Name="SharpenValue" DockPanel.Dock="Right" />
                                                            <TextBlock Text="Sharpen" Foreground="{DynamicResource Dim}" />
                                                        </DockPanel>
                                                        <Slider x:Name="SharpenSlider" Minimum="0" Maximum="100" SmallChange="5" LargeChange="10" IsSnapToTickEnabled="True" TickFrequency="5" ValueChanged="OnSignalSlider" AutomationProperties.Name="Sharpen" />
                                                        <TextBlock Style="{StaticResource Label}" Text="TV decoder" />
                                                        <UniformGrid Rows="1">
                                                            <RadioButton x:Name="DecoderNotch" Style="{StaticResource Segment}" GroupName="Decoder" Content="Simple" Tag="notch" Checked="OnDecoder" AutomationProperties.Name="Simple TV decoder" />
                                                            <RadioButton x:Name="DecoderComb" Style="{StaticResource Segment}" GroupName="Decoder" Content="Comb filter" Tag="comb" Margin="0" Checked="OnDecoder" AutomationProperties.Name="Comb filter TV decoder" />
                                                        </UniformGrid>
                                                        <TextBlock Style="{StaticResource Hint}"
                                                                   Text="A comb filter cleans up the colour fringes, and with them the colours that only exist in the signal (CGA, Apple II)." />
                                                        <!-- the tape's extras: copies, presets, and every one of the engine's settings -->
                                                        <DockPanel Margin="0,12,0,0">
                                                            <TextBlock x:Name="DubsValue" DockPanel.Dock="Right" />
                                                            <TextBlock Text="Dub it" Foreground="{DynamicResource Dim}" />
                                                        </DockPanel>
                                                        <Slider x:Name="DubsSlider" Minimum="0" Maximum="9" SmallChange="1" LargeChange="1" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnDubs"
                                                                AutomationProperties.Name="Dub it, copies of the tape" />
                                                        <TextBlock Style="{StaticResource Hint}" Text="Each copy goes through it all again, as a tape copied from a tape: a little worse each time." />
                                                        <TextBlock Style="{StaticResource Label}" Text="Presets" />
                                                        <ComboBox x:Name="PresetBox" SelectionChanged="OnPreset" AutomationProperties.Name="Signal presets" />
                                                        <WrapPanel Margin="0,8,0,0">
                                                            <Button x:Name="SavePresetButton" Content="Save as preset…" Click="OnSavePreset" Margin="0,0,8,6" ToolTip="Keep this Signal (connection, wear, every setting, copies) under a name" />
                                                            <Button x:Name="DeletePresetButton" Content="Delete preset" Click="OnDeletePreset" Margin="0,0,0,6" ToolTip="Delete your preset that's on now" />
                                                        </WrapPanel>
                                                        <Button x:Name="EverySettingButton" Content="Every setting…" Click="OnEverySetting" HorizontalAlignment="Stretch" Margin="0,4,0,0"
                                                                ToolTip="All of ntsc-rs's settings, the engine behind the Signal" />
                                                        <TextBlock x:Name="EngineNote" Style="{StaticResource Hint}" Visibility="Collapsed" />
                                                    </StackPanel>
                                                </Expander>
                                            </StackPanel>
                                            <TextBlock x:Name="SignalMoves" Style="{StaticResource Hint}" Margin="0,10,0,0"
                                                       Text="The noise moves when a GIF or a video plays, and in the animations and videos under Export." />
                                            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0">
                                                <Run Text="Signal engine: " /><Hyperlink Click="OnSignalEngine" ToolTip="github.com/valadaptive/ntsc-rs (opens your browser)">ntsc-rs</Hyperlink><Run Text=" by valadaptive (MIT) · " /><Hyperlink Click="OnSignalNotices" ToolTip="Help → About">notices</Hyperlink>
                                            </TextBlock>
                                        </StackPanel>
                                    </Expander>

                                    <Expander x:Name="ScreenSection" Style="{StaticResource Section}" Header="Scree_n">
                                        <StackPanel>
                                            <UniformGrid x:Name="ScreenButtons" Columns="4" Margin="0,0,-6,0" />
                                            <!-- the CRT's (the VHS, composite and phosphor screens are CRTs too) -->
                                            <StackPanel x:Name="CrtPanel">
                                                <StackPanel x:Name="MaskPanel">
                                                    <TextBlock Style="{StaticResource Label}" Text="Mask" />
                                                    <UniformGrid Rows="1">
                                                        <RadioButton x:Name="MaskNone" Style="{StaticResource Segment}" GroupName="Mask" Content="None" Tag="none" Padding="0" Checked="OnMask" AutomationProperties.Name="No mask" />
                                                        <RadioButton x:Name="MaskShadow" Style="{StaticResource Segment}" GroupName="Mask" Content="Shadow mask" Tag="shadow" Padding="0" Checked="OnMask" AutomationProperties.Name="Shadow mask" />
                                                        <RadioButton x:Name="MaskGrille" Style="{StaticResource Segment}" GroupName="Mask" Content="Aperture grille" Tag="grille" Padding="0" Margin="0" Checked="OnMask" AutomationProperties.Name="Aperture grille" />
                                                    </UniformGrid>
                                                </StackPanel>
                                                <DockPanel Margin="0,12,0,0">
                                                    <TextBlock x:Name="ScanlinesValue" DockPanel.Dock="Right" />
                                                    <TextBlock Text="Scanlines" Foreground="{DynamicResource Dim}" />
                                                </DockPanel>
                                                <Slider x:Name="ScanlinesSlider" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnFxSlider" AutomationProperties.Name="Scanlines" />
                                                <DockPanel Margin="0,8,0,0">
                                                    <TextBlock x:Name="CurveValue" DockPanel.Dock="Right" />
                                                    <TextBlock Text="Curve" Foreground="{DynamicResource Dim}" />
                                                </DockPanel>
                                                <Slider x:Name="CurveSlider" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnFxSlider" AutomationProperties.Name="Curve" />
                                                <StackPanel x:Name="BloomPanel">
                                                    <DockPanel Margin="0,8,0,0">
                                                        <TextBlock x:Name="BloomValue" DockPanel.Dock="Right" />
                                                        <TextBlock Text="Bloom" Foreground="{DynamicResource Dim}" />
                                                    </DockPanel>
                                                    <Slider x:Name="BloomSlider" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnFxSlider" AutomationProperties.Name="Bloom" />
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel x:Name="VhsPanel">
                                                <DockPanel Margin="0,8,0,0">
                                                    <TextBlock x:Name="TrackingValue" DockPanel.Dock="Right" />
                                                    <TextBlock Text="Tracking jitter &amp; noise" Foreground="{DynamicResource Dim}" />
                                                </DockPanel>
                                                <Slider x:Name="TrackingSlider" Minimum="0" Maximum="100" SmallChange="5" LargeChange="10" IsSnapToTickEnabled="True" TickFrequency="5" ValueChanged="OnFxSlider" AutomationProperties.Name="Tracking jitter and noise" />
                                                <CheckBox x:Name="OsdBox" Content="On-screen display (PLAY ▶)" Margin="0,8,0,0" Checked="OnOsd" Unchecked="OnOsd" />
                                            </StackPanel>
                                            <StackPanel x:Name="LcdPanel">
                                                <DockPanel Margin="0,12,0,0">
                                                    <TextBlock x:Name="GridValue" DockPanel.Dock="Right" />
                                                    <TextBlock Text="Pixel grid" Foreground="{DynamicResource Dim}" />
                                                </DockPanel>
                                                <Slider x:Name="GridSlider" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnFxSlider" AutomationProperties.Name="Pixel grid" />
                                                <DockPanel Margin="0,8,0,0">
                                                    <TextBlock x:Name="GhostValue" DockPanel.Dock="Right" />
                                                    <TextBlock Text="Ghosting" Foreground="{DynamicResource Dim}" />
                                                </DockPanel>
                                                <Slider x:Name="GhostSlider" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnFxSlider" AutomationProperties.Name="Ghosting" />
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                                       Text="For the preview. To keep it in the PNG, tick &quot;With the screen effect&quot; under Export (3× and up)." />
                                        </StackPanel>
                                    </Expander>

                                    <Expander x:Name="ExportSection" Style="{StaticResource Section}" Header="E_xport">
                                        <StackPanel>
                                            <StackPanel x:Name="ShapePanel">
                                                <TextBlock Style="{StaticResource Label}" Margin="0,0,0,4" Text="Pixel shape" />
                                                <UniformGrid Rows="1">
                                                    <RadioButton x:Name="ShapeRaw" Style="{StaticResource Segment}" GroupName="Shape" Content="Raw pixels" Checked="OnShape" AutomationProperties.Name="Raw pixels" />
                                                    <RadioButton x:Name="ShapeTv" Style="{StaticResource Segment}" GroupName="Shape" Content="As on a TV" Margin="0" Checked="OnShape" AutomationProperties.Name="As on a TV" />
                                                </UniformGrid>
                                                <TextBlock x:Name="ShapeNote" Style="{StaticResource Hint}" />
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource Label}" Text="Size" />
                                            <UniformGrid x:Name="Sizes" Columns="4" Margin="0,0,-6,0" />
                                            <TextBlock x:Name="SizeLine" Margin="0,8,0,0" TextWrapping="Wrap" FontFamily="Consolas" />
                                            <CheckBox x:Name="ExportFxBox" Content="With the screen effect" Margin="0,10,0,0" Checked="OnExportFx" Unchecked="OnExportFx" />
                                            <WrapPanel Margin="0,12,0,0">
                                                <Button x:Name="SaveButton" Content="_Save PNG…" Command="{x:Static local:Commands.SavePng}" Margin="0,0,8,6" />
                                                <Button x:Name="CopyButton" Content="_Copy picture" Command="{x:Static local:Commands.CopyPicture}" Margin="0,0,0,6" />
                                            </WrapPanel>
                                            <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0"
                                                       Text="Or drag the small picture under the preview into a folder or another program." />
                                            <!-- GIF and APNG: a loop of the picture, or an animated GIF's own frames -->
                                            <TextBlock Style="{StaticResource Label}" Text="Animation loop" />
                                            <UniformGrid x:Name="AnimStyles" Rows="1" Margin="0,0,-6,0" />
                                            <StackPanel x:Name="LoopRows" Visibility="Collapsed">
                                                <TextBlock Style="{StaticResource Label}" Text="Loop length" />
                                                <UniformGrid x:Name="LoopLengths" Rows="1" Margin="0,0,-6,0" />
                                                <TextBlock Style="{StaticResource Label}" Text="Loop speed" />
                                                <UniformGrid x:Name="LoopSpeeds" Rows="1" Margin="0,0,-6,0" />
                                            </StackPanel>
                                            <!-- a video's: the frame rate it goes out at, and its sound -->
                                            <StackPanel x:Name="VideoRows" Visibility="Collapsed">
                                                <TextBlock Style="{StaticResource Label}" Text="Frame rate" />
                                                <UniformGrid x:Name="VideoRates" Columns="4" Margin="0,0,-6,0" />
                                                <CheckBox x:Name="VideoKeepSound" Content="Keep the sound" Margin="0,10,0,0" Checked="OnVideoKeepSound" Unchecked="OnVideoKeepSound"
                                                          ToolTip="The MP4 keeps the video's sound, from its start to its stop" />
                                                <TextBlock x:Name="VideoHint" Style="{StaticResource Hint}" Margin="0,8,0,0" />
                                            </StackPanel>
                                            <WrapPanel Margin="0,12,0,0">
                                                <Button x:Name="SaveMp4Button" Content="Save MP4…" Click="OnSaveMp4" Margin="0,0,8,6" Visibility="Collapsed" ToolTip="The video through the look, from its start to its stop, with its sound" />
                                                <Button x:Name="SaveGifButton" Content="Save GIF…" Click="OnSaveGif" Margin="0,0,8,6" ToolTip="A looping GIF: the loop above, or an animated GIF's own frames" />
                                                <Button x:Name="SaveApngButton" Content="Save APNG…" Click="OnSaveApng" Margin="0,0,8,6" ToolTip="An animated PNG: full colour, played by browsers" />
                                                <Button x:Name="SaveFramesButton" Content="Save PNG frames…" Click="OnSaveFrames" Margin="0,0,8,6" Visibility="Collapsed" ToolTip="Every frame from its start to its stop as a numbered PNG, into a folder" />
                                                <Button x:Name="StopAnimationButton" Content="Stop" Click="OnStopAnimation" Margin="0,0,0,6" Visibility="Collapsed" AutomationProperties.Name="Stop making the animation" />
                                            </WrapPanel>
                                            <TextBlock x:Name="AnimHint" Style="{StaticResource Hint}" Margin="0,2,0,0" Visibility="Collapsed" />
                                            <!-- the website's wallpapers, and one for each of the PC's screens -->
                                            <TextBlock Style="{StaticResource Label}" Text="Wallpaper" />
                                            <UniformGrid x:Name="WallpaperButtons" Columns="2" Margin="0,0,-6,0" />
                                            <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0"
                                                       Text="Enlarged by the biggest whole step that fits, on its first colour." />
                                            <!-- the machine's own file, for emulators and editors -->
                                            <Button x:Name="EmulatorButton" Click="OnSaveEmulator" HorizontalAlignment="Stretch" Margin="0,12,0,0" Visibility="Collapsed" />
                                            <TextBlock x:Name="ExportNote" Style="{StaticResource Hint}" Visibility="Collapsed" />
                                            <Button x:Name="ShareButton" Content="Copy share lin_k" Click="OnCopyLink" HorizontalAlignment="Stretch" Margin="0,12,0,0"
                                                    ToolTip="A link that opens these settings on img.b0r3d.org (or here, pasted)" />
                                        </StackPanel>
                                    </Expander>

                                    <!-- every setting back to how a first start has them (the picture stays) -->
                                    <Button x:Name="ResetButton" Content="_Reset settings" Click="OnResetButton" HorizontalAlignment="Right" Margin="0,18,0,0" MinWidth="150" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- the picture -->
                        <Grid x:Name="StageArea" Grid.Column="1" Margin="24,18,24,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border x:Name="Stage" Background="{DynamicResource Stage}" CornerRadius="8" ClipToBounds="True">
                                <Grid>
                                    <local:PixelView x:Name="View" AutomationProperties.Name="The picture" />
                                    <TextBlock x:Name="TagOriginal" Text="Original" Style="{StaticResource Tag}" HorizontalAlignment="Left" Visibility="Collapsed" />
                                    <TextBlock x:Name="TagDeres" Text="DeRes" Style="{StaticResource Tag}" HorizontalAlignment="Right" Visibility="Collapsed" />
                                    <TextBlock x:Name="StageNote" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                               TextWrapping="Wrap" MaxWidth="420" Margin="20" Foreground="{DynamicResource Dim}" IsHitTestVisible="False" />
                                </Grid>
                            </Border>

                            <!-- an animated GIF's play bar: Play / Pause, the frame slider and its counter -->
                            <DockPanel x:Name="PlayBar" Grid.Row="1" Margin="0,10,0,0" Visibility="Collapsed">
                                <Button x:Name="PlayButton" DockPanel.Dock="Left" MinWidth="96" ToolTip="Play the GIF through the look, at its own speed" />
                                <TextBlock x:Name="FrameCounter" DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center" TextAlignment="Right" FontFamily="Consolas"
                                           AutomationProperties.Name="Frame number" />
                                <Slider x:Name="FrameSlider" Minimum="0" Maximum="1" SmallChange="1" LargeChange="1" IsSnapToTickEnabled="True" TickFrequency="1" IsMoveToPointEnabled="True"
                                        VerticalAlignment="Center" Margin="12,0,0,0" AutomationProperties.Name="Frame" />
                            </DockPanel>

                            <!-- a video's timeline: Play / Pause with its sound, a frame back and on, the time; and the stretch a save takes -->
                            <StackPanel x:Name="VideoBar" Grid.Row="1" Margin="0,10,0,0" Visibility="Collapsed">
                                <DockPanel>
                                    <Button x:Name="VideoPlayButton" DockPanel.Dock="Left" MinWidth="96" />
                                    <Button x:Name="StepBackButton" DockPanel.Dock="Left" Content="◀▮" MinWidth="34" Padding="0" Margin="6,0,0,0" ToolTip="A frame back" AutomationProperties.Name="A frame back" />
                                    <Button x:Name="StepOnButton" DockPanel.Dock="Left" Content="▮▶" MinWidth="34" Padding="0" Margin="4,0,0,0" ToolTip="A frame on" AutomationProperties.Name="A frame on" />
                                    <TextBlock x:Name="VideoTime" DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center" TextAlignment="Right" FontFamily="Consolas" AutomationProperties.Name="Time" />
                                    <Slider x:Name="TimeSlider" Minimum="0" Maximum="1" IsMoveToPointEnabled="True" VerticalAlignment="Center" Margin="12,0,0,0" AutomationProperties.Name="Time in the video" />
                                </DockPanel>
                                <DockPanel Margin="0,6,0,0">
                                    <CheckBox x:Name="VideoSoundBox" DockPanel.Dock="Right" Content="Sound" IsChecked="True" VerticalAlignment="Center" Margin="12,0,0,0"
                                              ToolTip="Its sound while it plays (a save keeps the sound when Export says so)" />
                                    <Button x:Name="SetStartButton" DockPanel.Dock="Left" Content="Start here" ToolTip="What's saved starts at the frame on screen" />
                                    <Button x:Name="SetStopButton" DockPanel.Dock="Left" Content="Stop here" Margin="6,0,0,0" ToolTip="What's saved stops after the frame on screen" />
                                    <Button x:Name="WholeButton" DockPanel.Dock="Left" Content="All of it" Margin="6,0,0,0" ToolTip="Save the whole video" />
                                    <TextBlock x:Name="RangeText" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Dim}" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </StackPanel>

                            <!-- (a fixed height: a readout of two lines never moves the picture) -->
                            <DockPanel x:Name="ViewBar" Grid.Row="2" Margin="0,10,0,0" Height="50">
                                <Border x:Name="DragOut" DockPanel.Dock="Left" Width="40" Height="40" Margin="0,0,12,0" CornerRadius="4" Cursor="Hand"
                                        Background="{DynamicResource Stage}" BorderBrush="{DynamicResource FieldLine}" BorderThickness="1"
                                        ToolTip="Drag the picture into a folder or another program" AutomationProperties.Name="Drag the picture out"
                                        MouseLeftButtonDown="OnDragOutDown" MouseMove="OnDragOutMove">
                                    <Image x:Name="DragThumb" Margin="3" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                </Border>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ToggleButton x:Name="CompareButton" Style="{StaticResource Toggle}" Content="Compare" Command="{x:Static local:Commands.Compare}" Margin="0,0,10,0"
                                                  ToolTip="Show the original left of a divider (drag it)" />
                                    <Button x:Name="FitButton" Content="Fit" MinWidth="0" Command="{x:Static local:Commands.ZoomFit}" ToolTip="See it all (Ctrl+0)" />
                                    <Button x:Name="ZoomOutButton" Content="−" MinWidth="34" Padding="0" Margin="6,0,0,0" Command="{x:Static local:Commands.ZoomOut}" ToolTip="Zoom out (Ctrl+-)" AutomationProperties.Name="Zoom out" />
                                    <TextBlock x:Name="ZoomText" MinWidth="64" TextAlignment="Center" VerticalAlignment="Center" FontFamily="Consolas" />
                                    <Button x:Name="ZoomInButton" Content="+" MinWidth="34" Padding="0" Command="{x:Static local:Commands.ZoomIn}" ToolTip="Zoom in (Ctrl++)" AutomationProperties.Name="Zoom in" />
                                    <Button x:Name="FullScreenButton" Content="Full screen" Margin="10,0,0,0" Command="{x:Static local:Commands.FullScreen}" ToolTip="Just the picture (F11; Esc to come back)" />
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="Readout" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" LineHeight="15" LineStackingStrategy="BlockLineHeight" MaxHeight="30"
                                               FontFamily="Consolas" AutomationProperties.LiveSetting="Polite" />
                                    <TextBlock x:Name="HoldHint" Style="{StaticResource Hint}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                               Text="Hold the picture (or Space) to see the original." />
                                </StackPanel>
                            </DockPanel>
                        </Grid>
                    </Grid>
                </TabItem>
            </TabControl>

            <!-- the name, on the tab strip -->
            <StackPanel x:Name="Brand" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18,4,0,0" IsHitTestVisible="False">
                <Image x:Name="CupPicture" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                <TextBlock Text="b0r3d DeRes" FontFamily="Courier New" FontWeight="Bold" FontSize="20" Margin="9,0,0,0" VerticalAlignment="Center" Effect="{DynamicResource TitleGlow}" />
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
